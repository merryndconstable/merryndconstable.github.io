@incollection{gallup_jr_self-recognition_2011,
	address = {New York, NY, US},
	series = {Oxford handbooks},
	title = {Self-recognition},
	isbn = {978-0-19-954801-9},
	abstract = {In this chapter we will focus on mirror self-recognition, the ability to recognize one's own image in a mirror. If self-awareness is the ability to become the object of your own attention, then mirrors can be used to measure and objectify this capacity. In front of a mirror you are the object of your own attention. When you look at yourself in a mirror you are an audience to your own behavior. Unlike most humans in the presence of mirrors, many species act as if they were seeing other organisms and often persist in treating the image as another animal. Therefore, from a scientific perspective, the question is whether an observer is capable of recognizing the dualism implicit in mirrors and realizing that its own behavior is the source of the behavior depicted in the reflection. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
