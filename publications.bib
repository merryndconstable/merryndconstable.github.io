}

@article{carruthers_mindreading_2017,
	title = {Mindreading in adults: {Evaluating} two-systems views},
	volume = {194},
	issn = {0039-7857, 1573-0964},
	shorttitle = {Mindreading in adults},
	url = {http://link.springer.com/10.1007/s11229-015-0792-3},
	doi = {10.1007/s11229-015-0792-3},
	abstract = {A number of convergent recent ﬁndings with adults have been interpreted as evidence of the existence of two distinct systems for mindreading that draw on separate conceptual resources: one that is fast, automatic, and inﬂexible; and one that is slower, controlled, and ﬂexible. The present article argues that these ﬁndings admit of a more parsimonious explanation. This is that there is a single set of concepts made available by a mindreading system that operates automatically where it can, but which frequently needs to function together with domain-speciﬁc executive procedures (such as visually rotating an image to ﬁgure out what someone else can see) as well as domain-general resources (including both long-term and working memory). This view, too, can be described as a two-systems account. But in this case one of the systems encompasses the other, and the conceptual resources available to each are the same.},
	language = {en},
	number = {3},
	urldate = {2019-04-20},
	journal = {Synthese},
	author = {Carruthers, Peter},
	month = mar,
	year = {2017},
	pages = {673--688},
	file = {Carruthers - 2017 - Mindreading in adults evaluating two-systems view.pdf:C\:\\Users\\merry\\Zotero\\storage\\PXIJR797\\Carruthers - 2017 - Mindreading in adults evaluating two-systems view.pdf:application/pdf},
}

@article{westra_spontaneous_2017,
