	keywords = {Nonlinear Sciences - Adaptation and Self-Organizing Systems, Mathematics - Dynamical Systems, Computer Science - Social and Information Networks},
	pages = {093134},
	file = {arXiv Fulltext PDF:C\:\\Users\\merry\\Zotero\\storage\\28W5JYEZ\\Reggio et al. - 2020 - Clusterization and phase diagram of the bimodal Ku.pdf:application/pdf;arXiv.org Snapshot:C\:\\Users\\merry\\Zotero\\storage\\CGKE4HQZ\\2007.html:text/html},
}

@misc{holmstrom_auditor_2023,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Auditor {Reliance} on {Opaque} {Audit} {Methods}: {The} {Effects} of {Auditor} {Ownership} and {Task} {Experience}},
	shorttitle = {Auditor {Reliance} on {Opaque} {Audit} {Methods}},
	url = {https://papers.ssrn.com/abstract=3596478},
	doi = {10.2139/ssrn.3596478},
	abstract = {Increasing access to data and advanced statistical methods can help auditors generate independent audit evidence such as independent expectations of estimates; however, such evidence is not useful unless auditors rely on it. I argue that advanced statistical methods are more opaque and that opacity affects the understanding and reliance on output of the methods. I further predict that psychological ownership of evidence increases reliance on evidence, especially when using more opaque methods. I conduct two experiments with auditors and find that task experience moderates my predicted effects. The results support my predicted interaction, specifically for auditors with moderate experience with the estimate settings. The results further suggest that my predicted effects may also depend on the relative complexity of the estimate (e.g., product warranty versus allowance for doubtful accounts). This study provides insights into auditors’ use of independent expectations and advanced methods that are becoming increasingly pervasive in practice.},
	language = {en},
	urldate = {2024-07-14},
	author = {Holmstrom, Kathryn M.},
	month = dec,
	year = {2023},
	keywords = {psychological ownership, control, audit evidence, data analytics, independent estimates, management estimates, opacity},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\TRKLW9IW\\Holmstrom - 2023 - Auditor Reliance on Opaque Audit Methods The Effe.pdf:application/pdf},
}

