	pages = {i2--i10},
	file = {Full Text:C\:\\Users\\merry\\Zotero\\storage\\PFM8CMNC\\Gaba - 2004 - The future vision of simulation in health care.pdf:application/pdf},
}

@article{foronda_virtual_2020,
	title = {Virtual {Simulation} in {Nursing} {Education}: {A} {Systematic} {Review} {Spanning} 1996 to 2018},
