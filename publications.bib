@article{boesch_hunting_1989,
	title = {Hunting behavior of wild chimpanzees in the {Taï} {National} {Park}},
	volume = {78},
	copyright = {Copyright © 1989 Wiley‐Liss, Inc., A Wiley Company},
	issn = {1096-8644},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/ajpa.1330780410},
	doi = {https://doi.org/10.1002/ajpa.1330780410},
	abstract = {Hunting is often considered one of the major behaviors that shaped early hominids' evolution, along with the shift toward a drier and more open habitat. We suggest that a precise comparison of the hunting behavior of a species closely related to man might help us understand which aspects of hunting could be affected by environmental conditions. The hunting behavior of wild chimpanzees is discussed, and new observations on a population living in the tropical rain forest of the Taï National Park, Ivory Coast, are presented. Some of the forest chimpanzees' hunting performances are similar to those of savanna-woodlands populations; others are different. Forest chimpanzees have a more specialized prey image, intentionally search for more adult prey, and hunt in larger groups and with a more elaborate cooperative level than savanna-woodlands chimpanzees. In addition, forest chimpanzees tend to share meat more actively and more frequently. These findings are related to some theories on aspects of hunting behavior in early hominids and discussed in order to understand some factors influencing the hunting behavior of wild chimpanzees. Finally, the hunting behavior of primates is compared with that of social carnivores.},
	language = {en},
	number = {4},
	urldate = {2021-04-30},
	journal = {American Journal of Physical Anthropology},
	author = {Boesch, Christophe and Boesch, Hedwige},
	year = {1989},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/ajpa.1330780410},
	keywords = {Cooperation, Sharing, Traditions},
	pages = {547--573},
	file = {Snapshot:C\:\\Users\\merry\\Zotero\\storage\\44PDI6Y2\\ajpa.html:text/html},
}

@article{gal_why_2021,
	title = {Why the sun will not set on the endowment effect: the endowment effect after loss aversion},
	volume = {39},
	issn = {2352-250X},
	shorttitle = {Why the sun will not set on the endowment effect},
	url = {https://www.sciencedirect.com/science/article/pii/S2352250X20301330},
	doi = {10.1016/j.copsyc.2020.07.021},
	abstract = {The endowment effect has had a profound influence on decision-making research, most notably as the lynchpin phenomenological evidence for loss aversion. However, both loss aversion and the interpretation of the endowment effect in terms of loss aversion have recently been called into question. Instead, recent research has argued that many instances in which the endowment effect has been attributed to loss aversion can be better explained by a tendency to favor omission over commission. This interpretation has implications for promoting change at the level of the individual and of the institution; in particular, it suggests that change can be promoted through framing omissions as acts of commission and through the use of sunset provisions.},
	language = {en},
	urldate = {2021-04-29},
	journal = {Current Opinion in Psychology},
	author = {Gal, David},
	month = jun,
	year = {2021},
	pages = {12--15},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\CVN7XWPL\\Gal - 2021 - Why the sun will not set on the endowment effect .pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\ISB2V5CN\\S2352250X20301330.html:text/html},
}

