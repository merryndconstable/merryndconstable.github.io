	author = {Horstmann, Kai T. and Ziegler, Matthias},
	year = {2020},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/per.2266},
	keywords = {assessment, reliability, experience sampling, personality states, validity},
	pages = {1037--1059},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\75M4BZWZ\\Horstmann and Ziegler - 2020 - Assessing Personality States What to Consider whe.pdf:application/pdf;Snapshot:C\:\\Users\\merry\\Zotero\\storage\\FS4DNUXS\\per.html:text/html},
}

@article{cowan_relation_2024,
