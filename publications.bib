	abstract = {Objective: Screening for cervical cancer requires the participation of target women. HPV testing can be performed on vaginal self-samples and self-sampling can improve this participation. This study aims to evaluate the analytical performance of a new vaginal self-sampling device (Vitroveil) to detect high risk human papillomavirus (hrHPV) in comparison to clinician collected samples and evaluate the degree of acceptability of the Vitroveil device. Methods: A cross-sectional observational study was carried out in a cohort of 385 participating women (median age of 44 ± 10.47 years) attending primary care centers and cervical pathology services of Granada, Spain. Two paired samples (vaginal self-sample and clinician collected cervical sample) where collected from each participant to compare the detection of HPV with the Vitro HPV Screening assay (Vitro, Granada, Spain). A questionnaire was also provided to the participants to analyze the degree of satisfaction with the device and the preference for sampling method. Results: Overall concordance for hrHPV detection was substantial (ĸ 0.804). The prevalence of any hrHPV infection was higher in self-collected samples (30.6\%) than in clinician-collected samples (24.3\%). The participants found the self-sampling device easy to use and preferred self-collection as the collection method. Conclusion: hrHPV can be safely and accurately performed on self-obtained vaginal samples by the help of Vitroveil self-sampling device with equivalent results to clinician-obtained specimens. This results and the high acceptability of the device among the women tested suggest that Vitroveil could be of great help to improve the participation of women on organized cervical cancer screenings.},
	language = {en},
	urldate = {2024-07-14},
	author = {Lopez Castro, Rodrigo and Escudero, Raquel and Calderón, Maria Ángeles and Iglesias Linares, Lucía and Hurtado González, María Dolores and Méndez Gómez, Nadia and De la Rosa Martos, Beatriz Emilia and Hidalgo Carmona, María Esther and López Hidalgo, Javier Luis},
	month = jan,
	year = {2024},
	keywords = {cervical cancer, extended genotyping, HPV, human papilloma virus, population-based screening, self-samples, vaginal self-collection},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\3JZ3Y2PV\\Lopez Castro et al. - 2024 - Performance of a Novel Vaginal Self-Collection Dev.pdf:application/pdf},
}

@misc{hackenburg_are_2023,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Are {Cultural} {Ecosystem} {Services} a {More} {Effective} than {Framing} than {Economics}? {Other} {Factors} {Overshadow} {Message} {Impact} on {Environmental} {Behaviors}},
	shorttitle = {Are {Cultural} {Ecosystem} {Services} a {More} {Effective} than {Framing} than {Economics}?},
	url = {https://papers.ssrn.com/abstract=4640605},
	doi = {10.2139/ssrn.4640605},
	abstract = {Tailoring communications to match an audience’s interests and beliefs is one strategy for encouraging pro-environmental behavior. Ecosystem services can be seen as a powerful communications concept in that they frame environmental issues in terms of their effects on human wellbeing. Using an online survey, we examined the effects of video messages about cyanobacteria blooms in Lake Champlain that focused on three different ecosystem services framings: services in economic terms, cultural services with an individual focus, and cultural services with a collective focus. In addition to the treatment, we considered the roles of political orientation, lakefront residency, personal relevance, information recall, place attachment, and socio-demographics on change in concern, behavioral intentions, and action. Place attachment strongly predicted both behavioral intentions and personal relevance of the message across all three videos. However, the video messages had no effect on any of the outcome variables except when considering lakefront residency. Not only did lakefront residents report greater place attachment, but respondents who received the individual cultural services message also found it more personally relevant, resulting in greater behavioral intentions than those receiving the collective cultural services message. Open-ended questions revealed additional factors potentially influencing people’s behavior—uncertainty about how to act, feelings of ecological grief, and negative reactions to certain messages. We explored what the lack of a main treatment effect and the presence of interactive and audience segmentation effects could mean for communicators and researchers interested in environmental behavior change.},
	language = {en},
	urldate = {2024-07-14},
	author = {Hackenburg, Diana and Gould, Rachelle K. and Fisher, Brendan},
	month = nov,
	year = {2023},
	keywords = {place attachment, cultural ecosystem services, Framing, pro-environmental behavior},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\VCQSG633\\Hackenburg et al. - 2023 - Are Cultural Ecosystem Services a More Effective t.pdf:application/pdf},
}

@misc{kausar_empowered_2024,
	title = {Empowered, {Accountable}, and {Committed}? {Applying} self-determination theory to examine work-place procrastination.},
	shorttitle = {Empowered, {Accountable}, and {Committed}?},
	url = {https://www.researchsquare.com/article/rs-4281333/v1},
	doi = {10.21203/rs.3.rs-4281333/v1},
	abstract = {Background – This research examines the role of psychological characteristics (psychological empowerment and psychological ownership) in reducing employees’ workplace procrastination. Further, using organizational commitment theory, this research examines the mediating mechanism of organizational commitment in the relationship between psychological characteristics and employees’ workplace procrastination.
Methods– Two studies were conducted to test our hypotheses. In Study 1, we collected online data from 146 working individuals via the crowdsourcing platform Prolific. For Study 2, we gathered data from 384 employees in the banking sector in Pakistan using a paper-and-pencil survey questionnaire. Both studies employed a time-lagged data collection approach to minimize common-method bias.
Results – The research findings supported our hypotheses that organizational commitment mediated the positive relationship between psychological characteristics and employees’ workplace procrastination.
Conclusion – Previous studies have focused on the factors responsible for employees’ workplace procrastination. This study advances our knowledge by identifying the antecedents of employees’ workplace procrastination and examining the underlying mediating mechanism.},
