	volume = {122},
	issn = {13882457},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1388245710004943},
	doi = {10.1016/j.clinph.2010.05.029},
	abstract = {Objective The neuronal response to hearing a subject’s own (SON) compared to other names has been examined in healthy subjects as well as in patients with disorders of consciousness. So far, on electroencephalographic data only event related potentials (ERPs) were considered. In this study, we examined the frequency properties to SON.
Methods Data of 17 healthy subjects was processed for equiprobable stimuli of SON, other- and backward-own name by calculating ERPs, evoked and induced activity for a period of 2000 ms from stimulus onset in the delta, theta, lower and upper alpha bands and averaging for four consequent temporal segments of 500 ms each.
Results For SON, the N1 component’s amplitude was larger while induced activity in the alpha band decreased in the second temporal segment (of 500-1000 ms). No differences between otherand own-name-backwards were found.
Conclusions The late reactivity may indicate responses to a stimulus after having recognized it. Alpha is known to play a role in attention and alertness. The results may reflect that the SON stimulus enhances alertness.},
	language = {en},
	number = {1},
	urldate = {2020-07-05},
	journal = {Clinical Neurophysiology},
	author = {Höller, Yvonne and Kronbichler, Martin and Bergmann, Jürgen and Crone, Julia Sophia and Ladurner, Gunther and Golaszewski, Stefan},
	month = jan,
	year = {2011},
	pages = {99--106},
	file = {Höller et al. - 2011 - EEG frequency analysis of responses to the own-nam.pdf:C\:\\Users\\merry\\Zotero\\storage\\2QSW2IG5\\Höller et al. - 2011 - EEG frequency analysis of responses to the own-nam.pdf:application/pdf},
