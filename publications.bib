@article{siposova_new_2019,
	title = {A new look at joint attention and common knowledge},
	volume = {189},
	url = {https://www.sciencedirect.com/science/article/pii/S0010027719300745},
	doi = {j.cognition.2019.03.019},
	abstract = {Everyone agrees that joint attention is a key feature of human social cognition. Yet, despite over 40 years of work and hundreds of publications on this topic, there is still surprisingly little agreement on what exactly joint attention is, and how the jointness in it is achieved. Part of the problem, we propose, is that joint attention is not a single process, but rather it includes a cluster of different cognitive skills and processes, and different re- searchers focus on different aspects of it. A similar problem applies to common knowledge. Here we present a new approach: We outline a typology of social attention levels which are currently all referred to in the literature as joint attention (from monitoring to common, mutual, and shared attention), along with corresponding levels of common knowledge. We consider cognitive, behavioral, and phenomenological aspects of the different levels as well as their different functions, and a key distinction we make in all of this is second-personal vs. third- personal relations. While we focus mainly on joint attention and common knowledge, we also briefly discuss how these levels might apply to other ‘joint’ mental states such as joint goals.},
	urldate = {2019-04-25},
	journal = {Cognition},
	author = {Siposova, Barbora and Carpenter, Malinda},
	year = {2019},
	keywords = {Communication, Joint action, Joint attention, Commitments, Common knowledge, Second-person relations},
	pages = {260--274},
	file = {10.1016@j.cognition.2019.03.019.pdf:/Users/merrynconstable/Downloads/10.1016@j.cognition.2019.03.019.pdf:application/pdf;A new look at joint attention and common knowledge - ScienceDirect:C\:\\Users\\merry\\Zotero\\storage\\B866P8RY\\S0010027719300745.html:text/html},
}

