}

@article{han_longitudinal_2015,
	title = {A {Longitudinal} {Investigation} of {Person}–{Organization} {Fit}, {Person}–{Job} {Fit}, and {Contextual} {Performance}: {The} {Mediating} {Role} of {Psychological} {Ownership}},
	volume = {28},
	issn = {0895-9285},
	shorttitle = {A {Longitudinal} {Investigation} of {Person}–{Organization} {Fit}, {Person}–{Job} {Fit}, and {Contextual} {Performance}},
	url = {https://doi.org/10.1080/08959285.2015.1021048},
	doi = {10.1080/08959285.2015.1021048},
	abstract = {In this study we present new insights into the relationships surrounding employees’ feelings of psychological ownership (PO) at work and the resulting effects on contextual performance. Characterized by a feeling of possession, PO has been theorized to have positive influences on the attitudes and behaviors of employees. To explore PO’s effects, we conducted a three-stage questionnaire survey of employees and their supervisors at a multinational pharmaceutical company in Taiwan. To help attenuate the errors associated with common method variance that trouble most studies using simultaneous data, a longitudinal approach was taken to investigate the relationships between person–organization fit, person–job fit, and PO. During the first stage of data collection, 330 questionnaires were sent to employees, and 168 (51\%) valid questionnaires were returned. During the second stage, questionnaires were sent to the 168 employees who had responded to the first-stage survey. There were 134 (80\%) valid questionnaires returned. Finally, during the third stage, questionnaires were sent to the supervisors of all 134 employees who had responded to the second-stage survey. There were 88 (66\%) valid questionnaires returned. Findings reveal that person–job fit was significantly related to PO, and PO was significantly related to contextual performance. However, contrary to predictions, person–organization fit was positively, but not significantly, related to PO. We conclude by discussing the implications of these findings for both academics and practitioners and make suggestions for future research.},
	number = {5},
	urldate = {2025-05-19},
	journal = {Human Performance},
	publisher = {Routledge},
	author = {Han, Tzu-Shian and , Hsu-Hsin, Chiang and , David, McConville and and Chiang, Chia-Ling},
	month = oct,
	year = {2015},
	note = {\_eprint: https://doi.org/10.1080/08959285.2015.1021048},
	pages = {425--439},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\342M4KNA\\Han et al. - 2015 - A Longitudinal Investigation of Person–Organizatio.pdf:application/pdf},
}

@article{rollero_does_2010,
	title = {Does place attachment affect social well-being?},
	volume = {60},
	issn = {1162-9088},
	url = {https://www.sciencedirect.com/science/article/pii/S1162908810000204},
	doi = {10.1016/j.erap.2010.05.001},
	abstract = {Although literature yields some insights on the connection between place and well-being, to date the direct influence of place attachment on the dimensions that characterize social well-being has not been explicitly investigated. The present study, conducted on 443 first-year undergraduates, had one main purposes: exploring the influence of place attachment – measured in relation to two different spatial ranges (neighborhood and city) – on the five components of social well-being. Results showed that place attachment globally affects social well-being, but noteworthy distinctions have to be specified both as to the spatial range investigated and the different dimensions of social well-being. Theoretical implications are discussed.
Résumé
Bien que la littérature se soit intéressée au rapport entre le lieu et le bien-être, jusqu’à présent l’influence directe de l’attachement à l’environnement sur les dimensions qui caractérisent le bien-être social n’a pas été explicitement examinée. Cette étude, conduite avec la participation de 443 étudiants, avait comme principal objectif d’explorer l’influence de l’attachement à l’environnement (place attachment) concernant deux unités spatiales différentes (quartier et ville). Les mesures ont portés sur cinq composants du bien-être social. Les résultats ont montré que l’attachement à l’environnement affecte le bien-être social, mais des distinctions remarquables doivent être spécifiées tant par rapport au type d’espace étudié qu’aux dimensions différentes de bien-être social.},
	number = {4},
	urldate = {2025-05-19},
	journal = {European Review of Applied Psychology},
	author = {Rollero, C. and De Piccoli, N.},
	month = oct,
	year = {2010},
	keywords = {Place attachment, Bien-être social, Social well-being, Spatial ranges, Unités spatiales},
	pages = {233--238},
	file = {ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\DNRUW6UQ\\S1162908810000204.html:text/html},
}

@article{vaske_place_2001,
	title = {Place {Attachment} and {Environmentally} {Responsible} {Behavior}},
	volume = {32},
	issn = {0095-8964},
	url = {https://doi.org/10.1080/00958960109598658},
	doi = {10.1080/00958960109598658},
	abstract = {This article illustrates how an attachment to a local natural resource can influence environmentally responsible behavior (ERB) in an individual's everyday life. Our study showed that 4 general (e.g., talking with others about environmental issues) and 3 specific (e.g., sorting recyclable trash) behavioral indicators reflected a single environmentally responsible latent construct. Following previous research, we operationalized place attachment using 2 concepts: (a) place dependence (i.e., a functional attachment) and (b) place identity (i.e., an emotional attachment). The influence of these two concepts on ERB was examined using a structural equation model. Data for this analysis were obtained from a survey of youth, 14-17 years of age (N = 182), who participated in local natural resource work programs. Results supported the predicted relationships. As hypothesized, place identity mediated the relationship between place dependence and responsible behavior. Place dependence influenced place identity (β = .88, p {\textless} .001, R 2 = .77), and place identity was significantly related to ERB (P = .63, p {\textless} .001, R 2 = .40). Overall, the model suggests that encouraging an individual's connection to a natural setting facilitates the development of general ERB.},
	number = {4},
	urldate = {2025-05-19},
	journal = {The Journal of Environmental Education},
	publisher = {Routledge},
	author = {Vaske, Jerry J. and and Kobrin, Katherine C.},
	month = jan,
	year = {2001},
	note = {\_eprint: https://doi.org/10.1080/00958960109598658},
	keywords = {place attachment, place dependence, place identity, community resources, environmentally responsible behavior},
	pages = {16--21},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\VARQWACR\\Vaske and and Kobrin - 2001 - Place Attachment and Environmentally Responsible B.pdf:application/pdf},
}

