	keywords = {Training, Cameras, computer vision, Tracking, training, Real-time systems, 3-D movement tracking, Cardiopulmonary resuscitation (CPR) human performance assessment, Man-machine systems, Sensor systems},
	pages = {755--760},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\merry\\Zotero\\storage\\EXTNFGVR\\7515151.html:text/html},
