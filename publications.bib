}

@article{bruijn_your_2012,
	title = {Your mistake is my mistake . . . or is it? {Behavioural} adjustments following own and observed actions in cooperative and competitive contexts},
	volume = {65},
	issn = {1747-0218},
	shorttitle = {Your mistake is my mistake . . . or is it?},
	url = {https://doi.org/10.1080/17470218.2010.545133},
	doi = {10.1080/17470218.2010.545133},
	abstract = {A social speeded choice-reaction-time task was used to study adaptive behaviours following own and observed actions (errors and correct responses) in cooperative and competitive contexts. After making an erroneous response, the appropriate remedial action to avoid future errors in speeded reaction tasks is to slow down. Consistent with previous results, people indeed slow down following their own errors. Importantly, people who slow down most following own errors also slow down following observed errors in a cooperative situation. In a competitive context, a different pattern was found. People accelerated after errors from their opponent. The current findings demonstrate that the social context determines the way people respond to the errors of others, indicating that the neural systems that control remedial actions are highly flexible. These systems may underlie social adaptive behaviour, enabling people to respond flexibly to other people's actions in a wide variety of social contexts.},
	number = {2},
	urldate = {2021-07-07},
	journal = {The Quarterly Journal of Experimental Psychology},
	publisher = {Routledge},
	author = {Bruijn, Ellen R. A. De and Mars, Rogier B. and Bekkering, Harold and Coles, Michael G. H.},
	month = feb,
	year = {2012},
	note = {\_eprint: https://doi.org/10.1080/17470218.2010.545133},
	keywords = {Cooperation, Social cognition, Adaptive behaviour, Competition, Error monitoring, Performance adjustments},
	pages = {317--325},
	file = {Snapshot:C\:\\Users\\merry\\Zotero\\storage\\V4S5PNG4\\17470218.2010.html:text/html},
}

