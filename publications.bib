@misc{luza_projective_2021,
	title = {Projective structures, neighborhoods of rational curves and {Painlev}'e equations},
	url = {http://arxiv.org/abs/1707.07868},
	doi = {10.48550/arXiv.1707.07868},
	abstract = {We investigate the duality between local (complex analytic) projective structures on surfaces and two dimensional (complex analytic) neighborhoods of rational curves having self-intersection +1. We study the analytic classification, existence of normal forms, pencil/fibration decomposition, infinitesimal symmetries. We deduce some transcendental result about Painlev'e equations.},
