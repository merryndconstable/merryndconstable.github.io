	pages = {152--157},
	file = {Goslin et al. - 2012 - Electrophysiological Examination of Embodiment in .pdf:C\:\\Users\\merry\\Zotero\\storage\\W72LWYX2\\Goslin et al. - 2012 - Electrophysiological Examination of Embodiment in .pdf:application/pdf},
}

@article{vainio_action_2020,
	title = {Action inhibition and affordances associated with a non-target object: {An} integrative review},
