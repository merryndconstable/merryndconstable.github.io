	note = {Place: Washington},
	keywords = {Psychology, Performance, China, Netherlands, Interpersonal Interaction, Teams, team performance, Human, article, Meta Analysis, US, Canada, 3660:Organizational Behavior, Spain, Germany, Belgium, Interdependence, outcome interdependence, Republic of Korea, Singapore, Taiwan, task interdependence, team design, team functioning},
	pages = {1825--1846},
}

