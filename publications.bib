@misc{depari_moving_2023,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {"{Moving} or {Not}?": {Psychological} {Factors} {Affecting} a {Community}'s {Responses} to {Environmental} {Disruption}},
	shorttitle = {"{Moving} or {Not}?},
	url = {https://papers.ssrn.com/abstract=4415324},
	doi = {10.2139/ssrn.4415324},
	abstract = {Disputes between authorities and high-risk communities following post-disaster displacements are not new. Nevertheless, understanding of factors affecting people’s decisions and responses to disruptions (i.e. relocate or not relocate), particularly in the Indonesian context, remains limited. Through the experience of the Pelemsari community, a culturally distinct community in Mount Merapi that once lived in an area less than five kilometers from the crater, this article attempts to explain how local residents responded to an unprecedented event in 2010 and the psychological factors promoting such behaviors. To examine these factors, this study used hermeneutic phenomenology, a methodology rooted in the people-place relationship and specifically used to unfold the meaning structures of a lived experience,  as well as semi-structured interviews, field observations, and document reviews. The study found that people’s strong place attachment affected their disaster responses during and after the 2010 eruption. This place attachment produced their collective force on the government to issue legal certificates of former homes, the selection of a relocation site based on its proximity to the former settlement, and the choice of upholding unity with neighbors therein.},
	language = {en},
	urldate = {2024-07-14},
	author = {Depari, Catharina Dwi Astuti and Lindell, Michael K.},
	month = apr,
	year = {2023},
	doi = {10.2139/ssrn.4415324},
	keywords = {Place attachment, Risk perception, Community relocation, Cultural Attachment, Post-disaster displacement},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\YUD9XPQC\\Depari and Lindell - 2023 - Moving or Not Psychological Factors Affecting .pdf:application/pdf},
}

