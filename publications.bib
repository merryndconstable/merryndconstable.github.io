	note = {Place: Washington},
	keywords = {Psychology, Teams, team performance, Intelligence, Human, article, Group Performance, 3020:Group \& Interpersonal Processes, Collective Behavior, Cognitive Ability, collective intelligence, factor analysis, group performance},
	pages = {1483--1492},
}

