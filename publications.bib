	volume = {25},
	issn = {1089-2699, 1089-2699},
	url = {https://www.proquest.com/scholarly-journals/dynamics-relationships-between-team-reflexivity/docview/2451171834/se-2?accountid=12860},
	doi = {10.1037/gdn0000144},
	abstract = {Objective: We integrated research on team reflexivity with the episode model of team process and theoretically accounted for team reflexivity—team performance link within the same episode and across an episode of performance as well as the feedback loop that occurs between the variables. 

Method: The study employed on a seven-wave longitudinal design with 120 teams (
N = 480) that performed a business simulation task to explore the reciprocal relationship between team reflexivity and team performance.

Results: The findings showed positive relationship between team reflection and team adaptation (ranges from .28 to .41, all
ps {\textless} .05) as well as between team adaptation and team performance within the same episode (ranges from .37 to .53, all
ps {\textless} .05), and found that the team performance during the task episode negatively related to team reflection during the subsequent task episode (ranges from −.22 to −.57, all
ps {\textless} .05). In addition, the results showed that the interaction between team performance and time was significant (γ = .13,
p {\textless} .05). It implies that the team performance—team reflexivity relationship was stronger early in the team lifecycle but became weaker over time.

Conclusions: Overall, this study extended team reflexivity theory and research by considering the reciprocal relationship between team reflexivity and team performance under a series of performance episodes and demonstrating that team performance has a cross-lagged, negative relationship with team reflexivity, between two performance episodes. (PsycInfo Database Record (c) 2021 APA, all rights reserved)
(Source: journal abstract) Impact statement
Highlights and Implications —•Extending team reflexivity theory and research by considering the reciprocal relationship between team reflexivity and team performance under a series of performance episodes and demonstrating that team performance has a cross-lagged, negative relationship with team reflexivity, between two performance episodes. •When previous team performance has a time-lagged relationship with subsequent episodic team reflexivity, the influence of team reflexivity on team performance takes less time, which only exits within the same episode, and does not have a cross-lagged effect. •The cross-lagged relationship between team performance and team reflexivity was stronger early in the team lifecycle but became weaker over time. •Relatively poor performance, like a discrepancy between the goal and current state, resulted in increased levels of subsequent team reflexivity, whereas when team performance goals are being met, no subsequent team reflection occurs because there is no need to seek better performance feedback. (PsycInfo Database Record (c) 2021 APA, all rights reserved)},
	language = {English},
	number = {2},
	journal = {Group Dynamics: Theory, Research, and Practice},
	publisher = {Educational Publishing Foundation, Educational Publishing Foundation},
	author = {Li, Ci-Rong and Li, Chun-Xuan and Lin, Chen-Ju},
	month = jun,
	year = {2021},
	keywords = {Female, Male, Psychology, China, Feedback, Theories, Teams, Human, article, Group Performance, 3020:Group \& Interpersonal Processes, Adaptation, Adulthood (18 yrs \& older), Empirical Study, Quantitative Study, team adaptation, Longitudinal Study, performance episode, team reflection, team regulatory theory},
	pages = {122--136},
}

@article{maynard_team_2021,
	title = {Team leader coaching intervention: {An} investigation of the impact on team processes and performance within a surgical context},
	volume = {106},
	issn = {0021-9010, 0021-9010},
	url = {https://www.proquest.com/scholarly-journals/team-leader-coaching-intervention-investigation/docview/2437514674/se-2?accountid=12860},
	doi = {10.1037/apl0000814},
	abstract = {We examined the impact of a team leader coaching intervention on episodic team processes (transition, action, interpersonal) and subsequent team performance outcomes within a surgical context. Specifically, we tested whether coaching team leaders (i.e., surgeons) on promoting effective teamwork facilitates team processes and two important outcomes—delays and distractions. Team processes were indexed using detailed observational protocols by subject-matter experts before and during surgeries. We employed an interrupted time series design whereby half of our participants received coaching midway through the longitudinal period and the remaining served as a quasi-control group. Team processes and outcomes were collected from multiple surgeries, per surgeon, both before and after the coaching intervention (
N = 223 surgeries total). Results from a multilevel mixed-model (treatment vs. control, over time) structural equation model suggest that teams where the surgeon (team leader) received the coaching intervention exhibited higher-quality team transition processes. Transition processes related positively to subsequent action and interpersonal processes, which in turn yielded improvements in two different surgical team performance outcomes. Theoretical and applied implications are discussed. (PsycInfo Database Record (c) 2021 APA, all rights reserved)
(Source: journal abstract)},
