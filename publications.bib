	keywords = {Semantics, Humans, Female, Male, Reaction Time, Adult, Psychomotor Performance, Analysis of Variance, Photic Stimulation, Joint memory effect, Task co-representation, Mental Recall, Cooperative Behavior, Incidental encoding, Motor activation},
	pages = {2376--2389},
	file = {Full Text:C\:\\Users\\merry\\Zotero\\storage\\6LC8U3ZY\\Elekes et al. - 2016 - Enhanced encoding of the co-actor's target stimuli.pdf:application/pdf},
