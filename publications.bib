@article{frischen_seeing_2009,
	title = {Seeing the world through another person’s eyes: {Simulating} selective attention via action observation},
	volume = {111},
	issn = {0010-0277},
	shorttitle = {Seeing the world through another person’s eyes},
	url = {https://www.sciencedirect.com/science/article/pii/S0010027709000444},
	doi = {10.1016/j.cognition.2009.02.003},
	abstract = {Selective attention is usually considered an egocentric mechanism, biasing sensory information based on its behavioural relevance to oneself. This study provides evidence for an equivalent allocentric mechanism that allows passive observers to selectively attend to information from the perspective of another person. In a negative priming task, participants reached for a red target stimulus whilst ignoring a green distractor. Distractors located close to their hand were inhibited strongly, consistent with an egocentric frame of reference. When participants took turns with another person, the pattern of negative priming shifted to an allocentric frame of reference: locations close to the hand of the observed agent (but far away from the participant’s hand) were inhibited strongly. This suggests that witnessing another’s action leads the observer to simulate the same selective attention mechanisms such that they effectively perceive their surroundings from the other person’s perspective.},
	language = {en},
	number = {2},
	urldate = {2021-03-18},
	journal = {Cognition},
	author = {Frischen, Alexandra and Loach, Daniel and Tipper, Steven P.},
	month = may,
	year = {2009},
	keywords = {Action observation, Mirror neuron system, Selective attention, Negative priming},
	pages = {212--218},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\6DNLCMPJ\\Frischen et al. - 2009 - Seeing the world through another person’s eyes Si.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\UIG6FRNE\\S0010027709000444.html:text/html},
}

