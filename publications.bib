@article{soderstrom_judgments_2015,
	title = {Judgments of learning as memory modifiers},
	volume = {41},
	issn = {1939-1285},
	doi = {10.1037/a0038388},
	abstract = {A frequent procedure used to study how individuals monitor their own learning is to collect judgments of learning (JOLs) during acquisition, considered to be important, in part, because such judgments are assumed to guide how individuals allocate their future learning resources. In such research, however, a tacit assumption is frequently made: Namely, that asking for such metacognitive judgments does not affect the learning process per se. In 3 experiments, the present research addressed the accuracy of this assumption and tested a possible account--based on aspects of Koriat's cue-utilization approach to JOLs (Koriat, 1997) and de Winstanley, Bjork, and Bjork's (1996) transfer-appropriate multifactor account of generation effects--for why the mere act of making JOLs might enhance later memory for the information so judged. Potential implications of the present findings for the future conduction of research using metacognitive measures as well as for students studying for exams is discussed.},
	language = {eng},
	number = {2},
	journal = {Journal of Experimental Psychology. Learning, Memory, and Cognition},
	author = {Soderstrom, Nicholas C. and Clark, Colin T. and Halamish, Vered and Bjork, Elizabeth Ligon},
	month = mar,
	year = {2015},
	keywords = {Humans, Female, Male, Neuropsychological Tests, Reaction Time, Adult, Memory, Judgment, Mental Recall, Cues, Paired-Associate Learning, Serial Learning},
	pages = {553--558},
}

