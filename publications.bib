	pages = {7378--7398},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\BFW9HRMD\\Gharaei and Ghomeishi - 2024 - Evaluating office design parameters' effects on th.pdf:application/pdf},
}

