@article{schleifer_mental_2008,
	title = {Mental stress and trapezius muscle activation under psychomotor challenge: a focus on {EMG} gaps during computer work},
	volume = {45},
	issn = {0048-5772},
	shorttitle = {Mental stress and trapezius muscle activation under psychomotor challenge},
	doi = {10.1111/j.1469-8986.2008.00645.x},
	abstract = {Momentary reductions in the electrical activity of working muscles (EMG gaps) contribute to the explanation for the relationship between psychosocial stress and musculoskeletal problems in computer work. EMG activity and gaps in the left and right trapezii were monitored in 23 participants under low and high mental workload (LMW and HMW) demands during computer data entry. Increases in EMG activity and decreases in EMG-gap frequencies in both left and right trapezius muscles were greater during HMW than LMW. In addition, heart period and end-tidal CO2 were lower during HMW, whereas self-reported mood states were higher during HMW. The correspondence between lower end-tidal CO2 and lower EMG-gap frequencies suggests that hyperventilation (overbreathing) may mediate trapezius muscle activation. The reduction of EMG gaps suggests that the salutary benefits of momentary rest from musculoskeletal work are diminished during mental stress.},
	language = {eng},
	number = {3},
	journal = {Psychophysiology},
	author = {Schleifer, Lawrence M. and Spalding, Thomas W. and Kerick, Scott E. and Cram, Jeffrey R. and Ley, Ronald and Hatfield, Bradley D.},
	month = may,
	year = {2008},
	keywords = {Humans, Female, Male, Middle Aged, Adult, Psychomotor Performance, Adolescent, Affect, Computers, Electromyography, Stress, Psychological, Muscle, Skeletal, Carbon Dioxide, Electrocardiography, Heart Rate, Respiratory Mechanics},
	pages = {356--365},
}

@article{schaap_drivers_2008,
	title = {Drivers' reactions to sudden braking by lead car under varying workload conditions; towards a driver support system},
	volume = {2},
	issn = {1751-9578},
	url = {https://digital-library.theiet.org/content/journals/10.1049/iet-its_20080030},
	doi = {10.1049/iet-its:20080030},
	abstract = {At urban intersections drivers handle multiple tasks simultaneously, making urban driving a complex task. An advanced driver assistance system may support drivers in this specific driving task, but the design details of such a system need to be determined before they can be fully deployed. A driving simulator experiment was conducted to determine the relationship between different subtasks of driving at urban intersections. Participants completed four drives, each comprising 20 comparable intersections with different traffic situations and encountered one unexpected braking event during the experiment. The effects of varying levels of event urgency on the relationship between different driving subtasks were studied. Furthermore, the influence of workload on this relationship was determined by giving half of the subjects an additional cognitive task. After the lead car braked unexpectedly, participants reduced speed and increased headway depending on the urgency of the braking event. Depending on the workload, participants returned to the normal speed and headway again after a number of intersections. Participants experiencing a high-workload drove more smoothly, except for those who had experienced the most urgent unexpected event. High workload additionally affected the length of the adjustments to the unexpected event.},
	language = {en},
	number = {4},
	urldate = {2022-12-28},
	journal = {IET Intelligent Transport Systems},
	publisher = {IET Digital Library},
	author = {Schaap, T. W. and Horst, A. R. A. van der and Arem, B. van and Brookhuis, K. A.},
	month = dec,
	year = {2008},
	pages = {249--257},
	file = {Snapshot:C\:\\Users\\merry\\Zotero\\storage\\B9FI9DYP\\iet-its_20080030.html:text/html},
}

