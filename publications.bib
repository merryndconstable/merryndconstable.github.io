	keywords = {Self-relevance, P3, Degree effect, Event-related potential},
	pages = {290--295},
	file = {ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\KJCV737Z\\S0301051111001001.html:text/html},
}

