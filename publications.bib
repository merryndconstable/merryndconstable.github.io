	note = {Place: Washington},
	keywords = {teamwork, Humans, Female, Male, Adult, Psychology, Cooperative Behavior, Anesthesiology, Patient Care Team, team performance, Teamwork, Human, article, Group Performance, Work Teams, Adulthood (18 yrs \& older), Empirical Study, Quantitative Study, Thirties (30-39 yrs), Young Adulthood (18-29 yrs), Monitoring, Switzerland, 3430:Professional Personnel Attitudes \& Characteristics, Nurses, Mental Models, Anesthesia, anesthesia inductions, General Anesthetics, Health Care Services, monitoring behavior, team mental model, teamwork in health care},
