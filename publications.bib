@article{jones_can_2004,
	title = {Can cardiopulmonary resuscitation injure the back?},
	volume = {61},
	issn = {0300-9572},
	url = {https://www.sciencedirect.com/science/article/pii/S0300957203004593},
	doi = {10.1016/j.resuscitation.2003.12.007},
	abstract = {Cardiopulmonary resuscitation (CPR) is performed frequently by nurses in general hospitals and often in compromised positions. This may induce injury to the rescuer’s spine particularly if the CPR procedure is continued for a considerable time before medical staff arrive. Back pain as an occupational symptom in nurses has received considerable attention in the medical literature, but there is no report on the effect of CPR on back discomfort. This article reports a survey of the CPR experience of nurses in general hospitals and nursing homes and explores the difficulties encountered by nurses during the CPR procedure. A questionnaire was sent to nurses who had CPR experience in three general hospitals and 20 nursing homes through the nursing administrators of the respective units. Analysis of 205 completed questionnaires showed that the duration of the CPR procedure could last up to 27min. While 86\% of the nurses performed CPR on a bed, 70\% of them had their legs hanging over the edge of the bed without support and 55\% had to turn their head or back to look at the ECG monitor during the procedure. Over 80\% experienced back discomfort during or after the CPR procedure and 56\% considered their back discomfort was related to the duration of the procedure. Twenty percent of the nurses suffered back injury or prolapsed disc and over 40\% of these ‘injured’ nurses considered their back injury was related to or aggravated by CPR. Results of this survey suggest there is a need to review the support given to nurses to ensure safe administration of the CPR procedure in the general ward environment.
Sumàrio
A reanimação cardio-pulmonar (CPR) é frequentemente efectuada por enfermeiras nos hospitais gerais e, muitas vezes em posições difı́ceis. Isto pode provocar lesão na coluna do socorrista, principalmente se o procedimento for continuado por um perı́odo considerável de tempo até chegar a equipa médica. A lombalgia como um sintoma ocupacional em enfermeiras recebeu uma atenção considerável na literatura mas não existe relato do efeito da CPR no desconforto lombar. Este artigo descreve um estudo da experiência em CPR de enfermeiras em hospitais gerais e lares e explora as dificuldades encontradas durante os procedimentos de CPR. Foi enviado um questionário a enfermeiras com experiência em CPR em três hospitais gerais e 20 lares, através dos Enfermeiros Administradores das respectivas unidades. A análise de 205 questionários preenchidos mostrou que a realização de CPR podia durar até 27 minutos. Enquanto 86\% das enfermeiras faziam CPR numa cama, 70\% delas tinham as pernas penduradas do bordo da cama, sem apoio e 55\% tinha de virar a cabeça ou as costas para olhar para o monitor durante as manobras. Mais de 80\% sofreram lombalgias durante ou após as manobras de CPR e 56\% considerou que o seu desconforto estava relacionado com a duração das manobras. 20 \% das enfermeiras sofreram lesões nas costas ou hernia discal e mais de 40\% destas enfermeiras “lesionadas” considerou que a sua lesão das costas estava relacionada ou foi agravada pela CPR. Os resultados desta pesquisa sugerem que existe a necessidade de rever o apoio dado às enfermeiras para assegurar o fornecimento de procedimentos de CPR seguros no ambiente de uma enfermaria geral.
Resumen
La reanimación cardiopulmonar (CPR) es frecuentemente realizada por enfermeras en hospitales generales, muchas veces en posiciones inadecuadas. Esto puede inducir lesión en la espalda del reanimador particularmente si el procedimiento de CPR es mantenido por un tiempo prolongado antes de la llegada del personal médico. El dolor de espalda ha recibido atención considerable como sı́ntoma ocupacional en las enfermeras, pero no hay reportes acerca del efecto de la CPR sobre el dolor de espalda. Este artı́culo reporta una investigación acerca de la experiencia de enfermeras en hospitales generales y casas de reposo, y explora las dificultades encontradas por las enfermeras durante el procedimiento de RCP. Se envió un cuestionario a las enfermeras que tenı́an experiencia en RCP, en tres hospitales generales y 20 casas de reposo, a través de los administradores de enfermerı́a de las unidades respectivas. El análisis de 205 cuestionarios completados mostró que la duración del procedimiento de CPR podı́a durar hasta 27 minutos. Mientras el 86\% de las enfermeras realizaron CPR sobre una cama, el 70\% de ellas tenı́an sus piernas colgando por el costado de la cama sin apoyo y el 55\% tenı́a que rotar su cabeza hacia atrás para mirar el monitor de ECG durante el procedimiento. Sobre el 80\% experimentaron molestias en la espalda durante o después de realizar CPR y el 56\% de las molestias fue atribuido a la duración del procedimiento. El 20\% de las enfermeras sufrı́an de lesión de espalda o prolapso discal y sobre el 40\% de estas enfermeras ‘lesionadas’ consideraron que su lesión de espalda estaba relacionada con o agravada por el CPR. Los resultados de esta encuesta sugieren la necesidad de revisar el apoyo dado a las enfermeras para asegurar administración segura del procedimiento de CPR en el ambiente de una sala de hospital.},
	language = {en},
	number = {1},
	urldate = {2021-12-25},
	journal = {Resuscitation},
	author = {Jones, Alice Y. M},
	month = apr,
	year = {2004},
	keywords = {Cardiopulmonary resuscitation, Back pain, Dolor de espalda, Lombalgia, Reanimação cardio-pulmonar (CPR), Reanimación cardiopulmonar},
	pages = {63--67},
	file = {ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\Q7284ZSB\\S0300957203004593.html:text/html},
