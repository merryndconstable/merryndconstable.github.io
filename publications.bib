	url = {https://papers.ssrn.com/abstract=4597522},
	doi = {10.2139/ssrn.4597522},
	abstract = {Driven by the concept of meta-universe, the virtual digital person market is rapidly heating up. From virtual singer Luo Tianyi to digital virtual idol Liu Yuxi, to virtual idol group A-SOUL, virtual host CCTV network small C, all kinds of virtual digital people frequently appear in the public vision. Therefore, based on social cognitive theory and attachment theory, this paper explores the relationship between the characteristic attributes of virtual digital people in short videos and consumers' viewing intention and analyzes the differential influence in behavioral intention for consumers with different attachment styles. Through three experiments, this paper analyzes the influence mechanism of virtual digital person features (cartoon vs. realistic) on consumers' viewing intention in short videos of virtual digital persons of different application types (service vs. non-service) and verifies the influence of consumers' attachment avoidance on the relationship between identity, novelty, and psychological ownership and consumers' willingness to use. The study found that: in the short videos of non-service VDPs, realistic VDPs are relatively more likely to trigger consumers' willingness to watch, and identity, novelty, and psychological ownership play a mediating role; in the short videos of service VDPs, realistic VDPs are relatively more likely to trigger consumers' willingness to watch, and identity and novelty play a mediating role; the avoidance attachment style to which consumers belong negatively influences consumers' willingness to watch; and the avoidance attachment style to which consumers belong negatively influences consumers' willingness to use VDPs. The attachment avoidance to which consumers belonged negatively moderated the effects of identity, novelty, and psychological ownership on viewing intention. This study enriches the research of social cognitive theory and attachment theory in the field of the virtual digital person (VDP) and also provides effective guidance for enterprises to better understand consumers' psychological perception and expand the positive effects of VDP application in the process of choosing VDP.},
	language = {en},
	urldate = {2024-07-14},
	author = {Zhang, Yi and Zhuang, Kexin},
	month = oct,
	year = {2023},
	keywords = {psychological ownership, attachment style, identity, virtual digital person, willingness to watch},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\Q8ZDC46I\\Zhang and Zhuang - 2023 - The Influence Mechanism of Virtual Digital Person'.pdf:application/pdf},
}

@misc{wen_can_2023,
	title = {Can reduction of local carbon emissions motivate participation in demand-side flexibility programs? {Evidence} from the {United} {Kingdom}},
	shorttitle = {Can reduction of local carbon emissions motivate participation in demand-side flexibility programs?},
	url = {https://www.researchsquare.com/article/rs-3411509/v1},
	doi = {10.21203/rs.3.rs-3411509/v1},
	abstract = {Increasing demand-side flexibility is important for decarbonising electricity systems with increasing intermittent and variable renewable energy. Although previous research has identified reduction of carbon emissions from electricity consumption as a driver for households to provide demand-side flexibility, it is not clear yet whether they are willing to provide additional flexibility if the emission reduction takes place locally. This study conducted an online factorial survey across the UK to investigate the determinants of domestic consumers\&\#039; willingness to participate in time-of-use and direct load control of electric vehicle charging and heat pump heating programs. The results show that consumers generally prefer the static time-of-use tariffs (programs) to more flexible, controlled charging/heating programs (e.g. vehicle-to-grid charging), but savings on electricity bills, the percentage of reduced carbon emissions, and localisation of emission reduction (i.e. contributing to local emission targets) can significantly motivate participation in demand-side flexibility programs. Keeping other variables constant, localisation of emission reduction can increase the likelihood of program acceptance by over 11{\textbackslash}\%. Socio-demographic variables (e.g age), energy-related behaviours (e.g. intention to buy an electric vehicle or a heat pump, the current expenditure in electricity), consumers\&\#039; trust in electricity service suppliers, their concerns over data privacy, and attitudes towards climate change and local carbon targets also influence household willingness to provide demand-side flexibility.},
	urldate = {2024-07-14},
	author = {Wen, Cheng and Steadman, Shandelle and Rafaq, Muhammad Saad and Vatougiou, Paraskevi and Deakin, Matthew},
	month = oct,
	year = {2023},
	note = {ISSN: 2693-5015},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\K38Q6KJH\\Wen et al. - 2023 - Can reduction of local carbon emissions motivate p.pdf:application/pdf},
}

@article{miszczak_rule_2023,
