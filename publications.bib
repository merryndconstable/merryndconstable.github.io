	type = {{SSRN} {Scholarly} {Paper}},
	title = {Restoring {Residents}’ {Place} {Attachment} in {Long} {Term} {Post}-{Disaster} {Recovery}: {The} {Role} of {Residential} {Environment}, {Tourism}, and {Social} and {Cultural} {Capital}},
	shorttitle = {Restoring {Residents}’ {Place} {Attachment} in {Long} {Term} {Post}-{Disaster} {Recovery}},
	url = {https://papers.ssrn.com/abstract=4748424},
	doi = {10.2139/ssrn.4748424},
	abstract = {Disaster caused place destruction and reconstruction affects residents’place attachment. How place attachment is restored post-disaster is a critical, yet understudied issue within the disaster literature. This study investigated a severely damaged town by the Wenchuan earthquake in China, and assessed the changed physical and social impacts on residents’ place attachment in relation to long term, post-disaster recovery. Utilizing structural equation modelling, the study identified that factors of residential environment and social capital have significant effects on place dependence and place identity. Post-disaster tourism significantly influences place dependence, and the cultural capital of disaster resilience significantly influences place dependence. Place dependence plays a mediating role between residential environment and place identity, and between post-disaster tourism and place identity. The findings provide theoretical and practical implications for the restoration of residents’ place attachment for long term, post-disaster recovery.},
	language = {en},
