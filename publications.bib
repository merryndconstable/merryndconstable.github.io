	keywords = {Humans, Female, Male, Adult, Social Perception, Interpersonal Relations, Young Adult, Models, Psychological, Fear, Hierarchy, Social, Peer Group, Psychological Tests, Social Class, Social Dominance},
	pages = {103--125},
	file = {Full Text:C\:\\Users\\merry\\Zotero\\storage\\VVHG7LG2\\Cheng et al. - 2013 - Two ways to the top evidence that dominance and p.pdf:application/pdf},
}

