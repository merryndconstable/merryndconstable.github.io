@misc{transiskus_beyond_2023,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Beyond the {Binary} of {Trapped} {Populations} and {Voluntary} {Immobility}: {A} {People}-{Centered} {Perspective} on {Environmental} {Change} and {Human} {Immobility} at {Lake} {Urmia}, {Iran}},
	shorttitle = {Beyond the {Binary} of {Trapped} {Populations} and {Voluntary} {Immobility}},
	url = {https://papers.ssrn.com/abstract=4499129},
	doi = {10.2139/ssrn.4499129},
	abstract = {Empirical research on the links between environmental change and human (im)mobility has made considerable progress in the last decade. However, people-centered perspectives remain scarce, various regions are critically understudied, and the focus is mostly on migration as opposed to understanding immobility. This paper seeks to address these deficits. Methodologically, it is based on 75 qualitative in-depth interviews and 8 focus group sessions with rural residents around desiccating Lake Urmia, Iran, one of the largest salt lakes on earth. In a multidisciplinary approach, the study takes individual perceptions of environmental degradation and lived experiences of immobility as its fundamental starting point. It investigates what (in)tangible losses occur and analyses what matters most in shaping the aspirations and capabilities to migrate or stay. The results show diverse immobility outcomes in the face of increasing water scarcity and severe salinization associated with the drying lake. Loss of agricultural income, limited options for adaptation and health concerns put migration pressures on rural stayers, who increasingly suffer from high rates of outmigration. Resource constraints make many people identify as involuntary immobile, while others reveal multifaceted motivations for their decision to stay. Deeply personal aspects like life course and attachment to place are stated as reasons for acquiescent or voluntary immobility. Some residents who wish to stay simultaneously refer to a perceived need and desire to migrate (ambivalent immobility). Exacerbated by the emotional distress caused by environmental disruptions and personal capability constraints, others describe the feeling of being trapped without expressing any (im)mobility aspirations at all (precarious immobility). Herein, this paper highlights the complexity of aspirations in times of environmental crisis and calls for more qualitative research to better explore diverse reasons, outcomes, and consequences of immobility.},
	language = {en},
	urldate = {2024-07-14},
	author = {Transiskus, Sebastian Fernand},
	month = jul,
	year = {2023},
	keywords = {Environmental ChangeImmobilityMigrationTrapped PopulationsPlace AttachmentIran},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\3QHHUCYC\\Transiskus - 2023 - Beyond the Binary of Trapped Populations and Volun.pdf:application/pdf},
}

@misc{stanford_scramblon_2023,
	title = {Scramblon loops},
	url = {http://arxiv.org/abs/2311.12121},
	doi = {10.48550/arXiv.2311.12121},
	abstract = {In large \$N\$ chaotic quantum systems, the butterfly effect is mediated by a collective field mode known as the ``scramblon.'' We study self-interactions of the scramblon in variants of the Sachdev-Ye-Kitaev model. In spatially extended versions of the model and for large spatial separation, fluctuations described by loop diagrams can invalidate the single-scramblon approximation well before its contribution to out-of-time-order correlators becomes of order one. We find a qualitative difference between an incoherent regime at high temperaure (or in a Brownian version of the model) and a coherent regime at low temperature.},
