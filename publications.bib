	doi = {10.1145/3656156.3663707},
	abstract = {Access-based Consumption (ABC) allows temporary access to goods rather than ownership. While ABC can support efficient usage of resources, it faces criticism for diminishing Psychological Ownership (PO, what people feel a sense of ownership over but not necessarily legally own), which can impact users’ ability to achieve their goals using the goods. With little research in HCI and Interaction Design on integrating PO into the design of shared objects, this study uses a Research-through-Design (RtD) approach, using university hot desks as the context. First, we established seven design principles to increase PO in hot desks, based on interviews and previous studies. These design principles were then explored through the design and initial evaluation of ResponTable, a hot desk that adapts its surface to user preferences. These principles, alongside the desk design concept, serve as a provocation to inspire future research and design in promoting PO within ABC more broadly.},
	urldate = {2025-09-07},
