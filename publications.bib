	file = {IEEE Xplore Abstract Record:C\:\\Users\\merry\\Zotero\\storage\\4SHZIA3P\\8968407.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\NTV69S2Y\\Sanchez-Matilla et al. - 2020 - Benchmark for Human-to-Robot Handovers of Unseen C.pdf:application/pdf},
