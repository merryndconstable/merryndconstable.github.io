@article{bekkering_transfer_1995,
	title = {Transfer of saccadic adaptation to the manual motor system},
	volume = {14},
	issn = {1872-7646},
	doi = {10.1016/0167-9457(95)00003-B},
	abstract = {Examined whether hand pointing was influenced by adaptive modification of saccadic eye movements. Six university students served as Ss in 4 sessions, containing 2 blocks of trials of 30 min each, on separate days. Stimuli presentation was computer controlled. A small fixation cross and a target dot appeared either at 8° or 10° to the right of the fixation cross, simultaneously. Ss with the aid of auditory stimuli moved a handle (fixed on their hands) to a small fixation cross at 0°. Results indicated that pointing movements of an unseen hand were shorter when the eye was adapted compared to when the eye was unadapted, thus demonstrating a transfer of the modification of occulomotor system to the manual motor system. Implications for the mechanisms underlying goal-directed eye and hand movements are presented. It is inferred from these results that the two systems may use a common signal to specify eye and arm localization. (PsycInfo Database Record (c) 2020 APA, all rights reserved)},
