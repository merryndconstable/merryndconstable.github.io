}

@article{de_klerk_baby_2015,
	title = {Baby steps: investigating the development of perceptual-motor couplings in infancy},
	volume = {18},
	issn = {1467-7687},
	shorttitle = {Baby steps},
	doi = {10.1111/desc.12226},
	abstract = {There are cells in our motor cortex that fire both when we perform and when we observe similar actions. It has been suggested that these perceptual-motor couplings in the brain develop through associative learning during correlated sensorimotor experience. Although studies with adult participants have provided support for this hypothesis, there is no direct evidence that associative learning also underlies the initial formation of perceptual-motor couplings in the developing brain. With the present study we addressed this question by manipulating infants' opportunities to associate the visual and motor representation of a novel action, and by investigating how this influenced their sensorimotor cortex activation when they observed this action performed by others. Pre-walking 7-9-month-old infants performed stepping movements on an infant treadmill while they either observed their own real-time leg movements (Contingent group) or the previously recorded leg movements of another infant (Non-contingent control group). Infants in a second control group did not perform any steps and only received visual experience with the stepping actions. Before and after the training period we measured infants' sensorimotor alpha suppression, as an index of sensorimotor cortex activation, while they watched videos of other infants' stepping actions. While we did not find greater sensorimotor alpha suppression following training in the Contingent group as a whole, we nevertheless found that the strength of the visuomotor contingency experienced during training predicted the amount of sensorimotor alpha suppression at post-test in this group. We did not find any effects of motor experience alone. These results suggest that the development of perceptual-motor couplings in the infant brain is likely to be supported by associative learning during correlated visuomotor experience.},
	language = {eng},
	number = {2},
	journal = {Developmental Science},
	author = {de Klerk, Carina C. J. M. and Johnson, Mark H. and Heyes, Cecilia M. and Southgate, Victoria},
	month = mar,
	year = {2015},
	keywords = {Humans, Female, Male, Psychomotor Performance, Electroencephalography, Analysis of Variance, Visual Perception, Movement, Time Factors, Infant, Association Learning, Child Development, Walking},
	pages = {270--280},
	file = {Full Text:C\:\\Users\\merry\\Zotero\\storage\\IAU856FI\\de Klerk et al. - 2015 - Baby steps investigating the development of perce.pdf:application/pdf},
}

@article{catmur_making_2011,
	title = {Making {Mirrors}: {Premotor} {Cortex} {Stimulation} {Enhances} {Mirror} and {Counter}-mirror {Motor} {Facilitation}},
	volume = {23},
	issn = {0898-929X},
	shorttitle = {Making {Mirrors}},
	url = {https://doi.org/10.1162/jocn.2010.21590},
	doi = {10.1162/jocn.2010.21590},
	abstract = {Mirror neurons fire during both the performance of an action and the observation of the same action being performed by another. These neurons have been recorded in ventral premotor and inferior parietal cortex in the macaque, but human brain imaging studies suggest that areas responding to the observation and performance of actions are more widespread. We used paired-pulse TMS to test whether dorsal as well as ventral premotor cortex is involved in producing mirror motor facilitation effects. Stimulation of premotor cortex enhanced mirror motor facilitation and also enhanced the effects of counter-mirror training. No differences were found between the two premotor areas. These results support an associative account of mirror neuron properties, whereby multiple regions that process both sensory and motor information have the potential to contribute to mirror effects.},
	number = {9},
	urldate = {2021-07-31},
	journal = {Journal of Cognitive Neuroscience},
	author = {Catmur, Caroline and Mars, Rogier B. and Rushworth, Matthew F. and Heyes, Cecilia},
	month = sep,
	year = {2011},
	pages = {2352--2362},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\GLI6HPN8\\Catmur et al. - 2011 - Making Mirrors Premotor Cortex Stimulation Enhanc.pdf:application/pdf},
}

