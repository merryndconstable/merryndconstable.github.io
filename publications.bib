@misc{xu_multiscale_2024,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Multiscale {Extended} {Finite} {Element} {Method} ({Ms}-{Xfem}) {Analysis} of {Deformation} of {Fractured} {Geological} {Formations} {Under} {Compression}},
	url = {https://papers.ssrn.com/abstract=4783631},
	doi = {10.2139/ssrn.4783631},
	abstract = {The activation and slip of fracture networks within geological formations pose significant risks, necessitating accurate and efficient simulation strategies. While the extended finite element method (XFEM) coupled with the penalty method accurately models this phenomenon, its efficiency diminishes when handling dense fracture networks. To resolve this challenge, in this work, a multiscale XFEM (MS-XFEM) for the simulation of self-contact and slip problem has been developed and presented. MS-XFEM approximates fine-scale displacement fields by interpolating solutions on a coarser-scale mesh using algebraically constructed basis functions. Notably, all extra degrees of freedom (DOFs) reside within the basis functions matrix instead of the coarse-scale solutions, which makes the coarse-scale system, a standard finite element based system. Proof-of-concept test cases illustrate MS-XFEM’s proficiency in simulating compressed fractured formations. The results underscore MS-XFEM’s accuracy and efficiency in modeling complex fracture networks under compression, signaling its promising application potential in practical field-scale scenarios.},
	language = {en},
	urldate = {2024-07-14},
	author = {Xu, Fanxiang and Hajibeygi, Hadi and Sluys, Lambertus J.},
	month = apr,
	year = {2024},
	keywords = {Compressed fracturedformations, Deformation of subsurface formations, Multiscale extendedfinite element method, Self-contact and slip},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\KXIBLF8B\\Xu et al. - 2024 - Multiscale Extended Finite Element Method (Ms-Xfem.pdf:application/pdf},
}

