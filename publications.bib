	pages = {1204--1213},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\merry\\Zotero\\storage\\J9FZVGC8\\8295119.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\TE7Z3MY6\\Allan et al. - 2018 - 3-D Pose Estimation of Articulated Instruments in .pdf:application/pdf},
