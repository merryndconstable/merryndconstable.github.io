@article{ogden_distortions_2021,
	title = {Distortions to the passage of time during {England}’s second national lockdown: {A} role for depression},
	volume = {16},
	issn = {1932-6203},
	shorttitle = {Distortions to the passage of time during {England}’s second national lockdown},
	url = {https://dx.plos.org/10.1371/journal.pone.0250412},
	doi = {10.1371/journal.pone.0250412},
	abstract = {In attempts to control the spread of the Covid-19 virus, many governments have resorted to imposing national lockdowns on their citizens. Previous research has demonstrated the passage of time becomes distorted for many people during these lockdowns. To date, research has only examined how time was experienced early in initial lockdowns. The current study examined whether distortions to the passage of time were also present later into the global pandemic. An online questionnaire was used to collect passage of time judgments for the day, week and 8 month period since the first UK lockdown. In addition, measures of affect, social satisfaction, task-load, compliance and health status were also recorded. The results show that over 80\% of people reported experiencing distortion to the passage of time during the second English lockdown in comparison with normal. Depression, satisfaction with social interaction and shielding status were found to be significant predictors of temporal distortion. A slower passage of time was associated with greater depression, shielding and greater dissatisfaction with social interactions. Feeling like it was longer than 8 months since the UK’s first lockdown was associated with greater depression, increased dissatisfaction with social interaction and greater change of life as a result of lockdown. The results suggest that distortions to the passage of time are an enduring feature of lockdown life and that different factors predict temporal experience during different points in lockdown.},
	language = {en},
	number = {4},
