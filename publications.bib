@article{de_ruijter_retention_2014,
	title = {Retention of first aid and basic life support skills in undergraduate medical students},
	volume = {19},
	issn = {1087-2981},
	doi = {10.3402/meo.v19.24841},
	abstract = {BACKGROUND: Undergraduate medical students follow a compulsory first aid (FA) and basic life support (BLS) course. Retention of BLS seems poor and only little information is provided on the retention of FA skills. This study aims at evaluating 1- and 2-year retention of FA and BLS training in undergraduate medical students.
METHODS: One hundred and twenty students were randomly selected from first year (n=349) medical students who successfully followed a compulsory FA and BLS course. From these 120 students, 94 (78\%) and 69 (58\%) participated in retention tests of FA and BLS skills after 1 and 2 years, respectively. The assessment consisted of two FA stations and one BLS station.
RESULTS: After 1 year, only 2\% passed both FA and BLS stations and 68\% failed both FA and BLS stations. After 2 years, 5\% passed and 50\% failed both FA and BLS stations. Despite the high failure rate at the stations, 90\% adequately checked vital signs and started cardiopulmonary resuscitation appropriately.
CONCLUSIONS: The long-term retention of FA and BLS skills after a compulsory course in the first year is poor. Adequate check of vital signs and commencing cardiopulmonary resuscitation retained longer.},
	language = {eng},
	journal = {Medical Education Online},
	author = {de Ruijter, Pim A. and Biersteker, Heleen A. and Biert, Jan and van Goor, Harry and Tan, Edward C.},
	year = {2014},
	keywords = {Humans, Female, Male, Young Adult, Adolescent, Educational Measurement, Education, Medical, Undergraduate, Students, Medical, basic life support, retention, education, first aid, First Aid, Life Support Care, medical students, Retention, Psychology, skills},
	pages = {24841},
	file = {Full Text:C\:\\Users\\merry\\Zotero\\storage\\A2WBAKUI\\de Ruijter et al. - 2014 - Retention of first aid and basic life support skil.pdf:application/pdf},
}

