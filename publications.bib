@article{he_are_2023,
	title = {Are {Empathic} {People} {Better} {Adjusted}? {A} {Test} of {Competing} {Models} of {Empathic} {Accuracy} and {Intrapersonal} and {Interpersonal} {Facets} of {Adjustment} {Using} {Self}- and {Peer} {Reports}},
