	keywords = {Human factors, Biomechanics, Ergonomics, Cognitive engineering, Human-systems integration},
	pages = {55--60},
	file = {ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\M2X77UML\\S0003687013000665.html:text/html},
}

