@article{bockler_observing_2011,
	title = {Observing shared attention modulates gaze following},
	volume = {120},
	issn = {00100277},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0010027711001272},
	doi = {10.1016/j.cognition.2011.05.002},
	abstract = {Humans’ tendency to follow others’ gaze is considered to be rather resistant to top-down inﬂuences. However, recent evidence indicates that gaze following depends on prior eye contact with the observed agent. Does observing two people engaging in eye contact also modulate gaze following? Participants observed two faces looking at each other or away from each other before jointly shifting gaze to one of two locations. Targets appeared either at the cued location or at the non-cued location. In three experiments gaze cueing effects (faster responses to objects appearing at the cued location) were found only when the two faces had looked at each other before shifting gaze. In contrast, no effects of gaze following were observed when the two faces had looked away from each other. Thus, the attentional relation between observed people modulates whether their gaze is followed.},
	language = {en},
	number = {2},
	urldate = {2019-04-25},
	journal = {Cognition},
	author = {Böckler, Anne and Knoblich, Günther and Sebanz, Natalie},
