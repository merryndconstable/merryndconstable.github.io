@article{myaskovsky_predictors_2012,
	title = {Predictors and {Outcomes} of {Health}-{Related} {Quality} of {Life} in {Caregivers} of {Cardiothoracic} {Transplant} {Recipients}},
	volume = {12},
	issn = {1600-6135},
	url = {https://www.sciencedirect.com/science/article/pii/S160061352227734X},
	doi = {10.1111/j.1600-6143.2012.04243.x},
	abstract = {Cardiothoracic transplant programs generally require that transplant recipients have family caregivers to assist them posttransplant. The burden of caregiving on the family members remains poorly understood. If caregivers’ well-being is compromised by caregiving, it may bode poorly for transplant recipients’ own health in the long-term posttransplant. We examined caregiver health-related quality of life (HRQOL) during the first year after their family member’s transplant, its predictors and its relationship to subsequent patient survival. Adult (aged 18+) caregivers of 242 cardiothoracic transplant recipients (lung = 134; heart = 108) completed assessments of demographics, psychosocial characteristics and caregiver burden at 2 months posttransplant, and HRQOL at 2, 7 and 12 months posttransplant. Recipients’ survival time was obtained from medical records. Caregiver HRQOL was generally high across the first-year posttransplant in emotional and social functioning; caregiver physical functioning significantly worsened. There were no differences by type of recipient transplant. Greater caregiver burden predicted poorer caregiver HRQOL in several physical domains at 12 months posttransplant. Transplant recipients whose caregivers had lower perceived general health at 12 months posttransplant showed poorer survival rates during the subsequent 7 years of follow up. Transplant teams should identify those caregivers at risk for poorer general health posttransplant to maximize positive outcomes for the entire family.},
	number = {12},
	urldate = {2024-06-04},
	journal = {American Journal of Transplantation},
	author = {Myaskovsky, L. and Posluszny, D. M. and Schulz, R. and DiMartini, A. F. and Switzer, G. E. and Dabbs, A. DeVito and McNulty, M. L. and Kormos, R. L. and Toyoda, Y. and Dew, M. A.},
	month = dec,
	year = {2012},
	keywords = {caregivers, Cardiothoracic transplant, psychosocial resources, quality of life},
	pages = {3387--3397},
	file = {Accepted Version:C\:\\Users\\merry\\Zotero\\storage\\3ERA39EG\\Myaskovsky et al. - 2012 - Predictors and Outcomes of Health-Related Quality .pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\8JUNRKRU\\S160061352227734X.html:text/html},
}

@article{jesse_findings_2021,
	title = {Findings and recommendations from the organ transplant caregiver initiative: {Moving} clinical care and research forward},
	volume = {21},
	issn = {1600-6135},
	shorttitle = {Findings and recommendations from the organ transplant caregiver initiative},
	url = {https://www.sciencedirect.com/science/article/pii/S1600613522084325},
	doi = {10.1111/ajt.16315},
	abstract = {Lay-caregivers are essential to the continuum of care in adult organ transplantation. However, we have a limited understanding of the experiences, exigencies, and outcomes associated with lay-caregiving for organ transplant patients. While much discussion and debate has focused on caregiver requirements in relation to transplant candidate selection, little focus has been given to understanding the needs of caregivers themselves. In response to this, the Organ Transplant Caregiver Initiative was created, and a meeting was held during October 6–7, 2019. Transplant healthcare professionals, researchers, and lay-caregivers discussed the experiences, educational needs, existing research, and research recommendations to improve the experience of lay-caregivers for adult organ transplant patients. In this report, we summarize the Organ Transplant Caregiver Initiative and meeting findings, providing a preliminary action plan to improve education, research, and advocacy for organ transplant caregivers.},
	number = {3},
	urldate = {2024-06-04},
	journal = {American Journal of Transplantation},
	author = {Jesse, Michelle T. and Hansen, Beverly and Bruschwein, Heather and Chen, Gloria and Nonterah, Camilla and Peipert, John Devin and Dew, Mary Amanda and Thomas, Charlie and Ortega, Adilia D. and Balliet, Wendy and Ladin, Keren and Lerret, Stacee and Yaldo, Alexander and Coco, Tiffany and Mallea, Jorge},
	month = mar,
	year = {2021},
	keywords = {education, editorial/personal viewpoint, ethics and public policy, mental health, patient education, social sciences},
	pages = {950--957},
	file = {Full Text:C\:\\Users\\merry\\Zotero\\storage\\JIQ674UK\\Jesse et al. - 2021 - Findings and recommendations from the organ transp.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\Q32ALVAH\\S1600613522084325.html:text/html},
}

@article{zhou_associations_2021,
	title = {Associations of {Caregiving} {Knowledge} and {Skills} {With} {Caregiver} {Burden}, {Psychological} {Well}-{Being}, and {Coping} {Styles} {Among} {Primary} {Family} {Caregivers} of {People} {Living} {With} {Schizophrenia} in {China}},
	volume = {12},
	issn = {1664-0640},
	url = {https://www.frontiersin.org/journals/psychiatry/articles/10.3389/fpsyt.2021.631420/full},
	doi = {10.3389/fpsyt.2021.631420},
	abstract = {{\textless}p{\textgreater}{\textless}bold{\textgreater}Background:{\textless}/bold{\textgreater} There is a lack of clarity regarding the correlation of caregiving knowledge and skills with caregiving experiences of people living with schizophrenia (PLSs). To address this gap, this comprehensive study examines the relationships of caregiving knowledge and skills to the primary family caregiver's experiences of burden, psychological well-being (stress, anxiety, depression, caregiving rewarding feelings), and coping styles in China.{\textless}/p{\textgreater}{\textless}p{\textgreater}{\textless}bold{\textgreater}Methods:{\textless}/bold{\textgreater} A total of 395 primary family caregivers of PLSs were enrolled in a cross-sectional study between May 2019 and September 2019. Each family caregiver was independently assessed on caregiving knowledge and skills, caregiver burden, and psychological well-being, as well as coping styles.{\textless}/p{\textgreater}{\textless}p{\textgreater}{\textless}bold{\textgreater}Results:{\textless}/bold{\textgreater} A higher level of caregiving knowledge and skills was positively correlated with less stress ({\textless}italic{\textgreater}b{\textless}/italic{\textgreater} = −0.48, {\textless}italic{\textgreater}P{\textless}/italic{\textgreater} \&lt; 0.001), anxiety ({\textless}italic{\textgreater}b{\textless}/italic{\textgreater} = −0.23, {\textless}italic{\textgreater}P{\textless}/italic{\textgreater} = 0.029), depression ({\textless}italic{\textgreater}b{\textless}/italic{\textgreater} = −0.29, {\textless}italic{\textgreater}P{\textless}/italic{\textgreater} = 0.013), and more caregiving rewarding feelings ({\textless}italic{\textgreater}b{\textless}/italic{\textgreater} = 0.54, {\textless}italic{\textgreater}P{\textless}/italic{\textgreater} \&lt; 0.001). Also, caregivers with more knowledge and skills were more inclined to adopt positive coping strategies ({\textless}italic{\textgreater}b{\textless}/italic{\textgreater} = 0.44, {\textless}italic{\textgreater}P{\textless}/italic{\textgreater} \&lt; 0.001). Despite these differences, caregivers with different levels of caregiving knowledge and skills reported comparable caregiver burden ({\textless}italic{\textgreater}b{\textless}/italic{\textgreater} = 0.11, {\textless}italic{\textgreater}P{\textless}/italic{\textgreater} = 0.705) and the use of a passive coping style ({\textless}italic{\textgreater}b{\textless}/italic{\textgreater} = 0.10, {\textless}italic{\textgreater}P{\textless}/italic{\textgreater} = 0.169).{\textless}/p{\textgreater}{\textless}p{\textgreater}{\textless}bold{\textgreater}Conclusion:{\textless}/bold{\textgreater} Caregiving knowledge and skills are a reliable predictor of psychological well-being and active coping among the primary family caregivers of PLSs. These findings inform the development of psychoeducational interventions to support family caregivers of PLSs.{\textless}/p{\textgreater}},
	language = {English},
	urldate = {2024-06-04},
	journal = {Frontiers in Psychiatry},
	publisher = {Frontiers},
	author = {Zhou, Zonglei and Wang, Yao and Feng, Ping and Li, Tongxin and Tebes, Jacob Kraemer and Luan, Rongsheng and Yu, Yu},
	month = may,
	year = {2021},
	keywords = {Schizophrenia, caregiver burden, caregiving knowledge and skills, Coping styles, Primary family caregivers, psychological well-being},
	file = {Full Text:C\:\\Users\\merry\\Zotero\\storage\\SJL3DLYT\\Zhou et al. - 2021 - Associations of Caregiving Knowledge and Skills Wi.pdf:application/pdf},
}

