	pages = {213--218},
	file = {Accepted Version:C\:\\Users\\merry\\Zotero\\storage\\GN3BVQBC\\Sbernini et al. - 2018 - Sensory-Glove-Based Open Surgery Skill Evaluation.pdf:application/pdf;IEEE Xplore Abstract Record:C\:\\Users\\merry\\Zotero\\storage\\VMADGXUG\\8267323.html:text/html},
