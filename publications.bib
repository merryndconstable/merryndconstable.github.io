@article{naik_personalized_2018,
	title = {Personalized video feedback improves suturing skills of incoming general surgery trainees},
	volume = {163},
	issn = {0039-6060, 1532-7361},
	url = {https://www.surgjournal.com/article/S0039-6060(17)30826-7/abstract},
	doi = {10.1016/j.surg.2017.11.006},
	abstract = {{\textless}h2{\textgreater}Abstract{\textless}/h2{\textgreater}{\textless}h3{\textgreater}Background{\textless}/h3{\textgreater}{\textless}p{\textgreater}The American Board of Surgery encourages graduating medical students to prepare for surgical residency before day 1. We sought to determine the impact of personalized video feedback on an advance preparation task.{\textless}/p{\textgreater}{\textless}h3{\textgreater}Methods{\textless}/h3{\textgreater}{\textless}p{\textgreater}We conducted a nonrandomized study comparing video feedback versus no feedback. We sent incoming surgical interns a preparatory package 2 months before starting residency. Trainees video-recorded themselves performing a subcuticular wound closure, 3 times at 3-week intervals, and submitted these for appraisal. A staff surgeon provided personalized feedback on each video as a narrated voiceover. The voiced-over videos were then returned to trainees. We compared performance (time and completion rate) on suturing in a multistation assessment against residents from the previous year (no-feedback group).{\textless}/p{\textgreater}{\textless}h3{\textgreater}Results{\textless}/h3{\textgreater}{\textless}p{\textgreater}The feedback group had a higher completion rate for the suturing assessment than the no-feedback group (23/28 [82\%] vs. 8/27 [30\%], \textit{P} {\textless} .0001). The feedback group also completed the suturing station at a faster rate than those without feedback (hazard ratio 4.9 [95\% confidence interval (CI): 2.2,11.2), \textit{P} {\textless} .0001). Global rating scores were significantly higher for the feedback group (mean difference [5-point scale] = 0.7 [95\% CI: 0.3, 1.1]). However, Objective Structured Assessment of Technical Skills scores indicated no significant difference between groups (mean difference [5-point scale] = 0.3 [95\% CI: 0.0, 0.6]). Within the feedback group, we found significant improvement from baseline to final performances (mean difference = 109 seconds [95\% CI: 79, 140]).{\textless}/p{\textgreater}{\textless}h3{\textgreater}Conclusion{\textless}/h3{\textgreater}{\textless}p{\textgreater}Personalized narrated feedback as part of a home-based advance preparation package for incoming residents is associated with higher performance on early objective assessments.{\textless}/p{\textgreater}},
	language = {English},
	number = {4},
	urldate = {2020-12-24},
	journal = {Surgery},
	publisher = {Elsevier},
	author = {Naik, Nimesh D. and Abbott, Eduardo F. and Gas, Becca L. and Murphy, Brittany L. and Farley, David R. and Cook, David A.},
	month = apr,
	year = {2018},
	pages = {921--926},
	file = {Snapshot:C\:\\Users\\merry\\Zotero\\storage\\Z6TQ8WAJ\\fulltext.html:text/html},
}

@article{forsyth_errors_2017,
	title = {Do errors and critical events relate to hernia repair outcomes?},
	volume = {213},
	issn = {0002-9610, 1879-1883},
	url = {https://www.americanjournalofsurgery.com/article/S0002-9610(16)30898-4/abstract},
	doi = {10.1016/j.amjsurg.2016.11.020},
	abstract = {{\textless}h2{\textgreater}Abstract{\textless}/h2{\textgreater}{\textless}h3{\textgreater}Background{\textless}/h3{\textgreater}{\textless}p{\textgreater}The study aimed to validate an error checklist for simulated laparoscopic ventral hernia (LVH) repair procedures. We hypothesize that residents' errors can be assessed with a structured checklist and the results will correlate significantly with procedural outcomes.{\textless}/p{\textgreater}{\textless}h3{\textgreater}Methods{\textless}/h3{\textgreater}{\textless}p{\textgreater}Senior residents' (N = 7) performance on a LVH simulator were video-recorded and analyzed using a human error checklist. Junior residents (N = 38) performed two steps of the same simulated LVH procedure. Performance was evaluated using the error checklist and repair quality scores.{\textless}/p{\textgreater}{\textless}h3{\textgreater}Results{\textless}/h3{\textgreater}{\textless}p{\textgreater}There were no significant differences between senior and junior residents' checklist errors (p {\textgreater} 0.1). Junior residents' errors correlated with hernia repair quality (p = 0.05).{\textless}/p{\textgreater}{\textless}h3{\textgreater}Conclusions{\textless}/h3{\textgreater}{\textless}p{\textgreater}The newly developed assessment tool showed significant correlations between performance errors, critical events, and hernia repair quality. These results provide validity evidence for the use of errors in performance assessments.{\textless}/p{\textgreater}{\textless}h3{\textgreater}Summary{\textless}/h3{\textgreater}{\textless}p{\textgreater}This study validated an error checklist for simulated laparoscopic ventral hernia (LVH) repair procedures. The checklist was designed based on errors committed by chief surgery residents during LVH repairs. In a separate data collection, junior residents were evaluated using the checklist. Hernia repair quality was also assessed. Errors significantly correlated with hernia repair quality (p = 0.05).{\textless}/p{\textgreater}},
	language = {English},
	number = {4},
	urldate = {2020-12-24},
	journal = {The American Journal of Surgery},
	publisher = {Elsevier},
	author = {Forsyth, Katherine Law and DiMarco, Shannon M. and Jenewein, Caitlin G. and Ray, Rebecca D. and D'Angelo, Anne-Lise D. and Cohen, Elaine R. and Wiegmann, Douglas A. and Pugh, Carla M.},
	month = apr,
	year = {2017},
	pages = {652--655},
	file = {Snapshot:C\:\\Users\\merry\\Zotero\\storage\\LRXXCZP7\\fulltext.html:text/html},
}

