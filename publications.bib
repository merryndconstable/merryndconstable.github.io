@misc{thorsen_seeing_2022,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Seeing {Covid} {Place} {Attachments}: {Opening} {Alternative} {Data} {Imaginaries} in {Urban} {Studies} with {Instagram} {Photos} and {Computational} {Visual} {Methods}},
	shorttitle = {Seeing {Covid} {Place} {Attachments}},
	url = {https://papers.ssrn.com/abstract=4159361},
	doi = {10.2139/ssrn.4159361},
	abstract = {Planners, policy makers and scholars are increasingly using social media data to study public life in cities. But, as argued in this paper, such projects tend to be limited by three commitments that shape the imaginaries of data-driven urbanism, namely 1) bias towards textual social media; 2) fixation on geotag-ontologies; and 3) frames of the subjectivity behind data as a bias. The consequence is that the potential of digital traces for renewing the empirical ground and methodological toolbox of urban studies is not fully realized. We provide a bibliometric review of these trends and suggest how especially social media images could be used to study place attachments and explore how users experience public space, bridging phenomenological research questions with the computational agenda. Second, to exemplify what can be gained from such a re-orientation of urban projects, we deliver a digital methods study of 39K Instagram posts from 2020 and explore how people in Denmark attached to different spaces during the first nine months of COVID-19. The case demonstrates how we might open new empirical routes in urban studies by centering image data, moving beyond simple geotag-ontologies, and foregrounding the subjectivity of data as an analytical opportunity, rather than a problem.},
	language = {en},
	urldate = {2024-07-14},
	author = {Thorsen, Sofie and Munk, Anders Kristian},
	month = jul,
	year = {2022},
	keywords = {computer vision, digital methods, image analysis, place attachment, Urban Studies, visual methodologies},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\NCXZ3D89\\Thorsen and Munk - 2022 - Seeing Covid Place Attachments Opening Alternativ.pdf:application/pdf},
}

