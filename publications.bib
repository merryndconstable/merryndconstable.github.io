@misc{azaad_ai-accelerated_2025,
	title = {{AI}-accelerated meta-analysis in psychology: {Large} language models code study properties with high accuracy},
	shorttitle = {{AI}-accelerated meta-analysis in psychology},
	url = {https://osf.io/preprints/psyarxiv/2rs7y_v1/},
	doi = {10.31234/osf.io/2rs7y_v1},
	abstract = {Theoretically-driven meta-analyses often involve testing whether study characteristics moderate an effect in a pattern that supports one of multiple competing theoretical accounts. To conduct such analyses, researchers must manually extract, i.e., code, these characteristics from sometimes hundreds of studies. Ideally, studies should be coded by two researchers independently to prevent errors and biases from compromising the dataset’s integrity. The laborious nature of this task, however, means that meta-analysts usually settle for double-coding just a portion of the studies included in their study. Some researchers have proposed using large language models (LLMs) as a double-coder, showing that they can reliably extract explicitly stated information (e.g., publication year) from articles. However, meta-analyses in psychology generally require studies to be coded in terms of higher-level conceptual dimensions (e.g., the type of behaviour rather than which behaviour). The present study investigated whether two LLMs, OpenAI’s GPT-5 and Google’s Gemini 2.5 Pro, can code studies in this way. Both models replicated study codes from three recently published meta-analyses in psychology with high accuracy (\&gt;92\% overall), despite limitations in the information that they received. LLM double-coding, therefore, offers a practical solution for meta-analysts seeking to ensure data integrity.},
	urldate = {2025-11-20},
	publisher = {PsyArXiv},
	author = {Azaad, Shaheed},
	month = oct,
	year = {2025},
	file = {Preprint PDF:C\:\\Users\\merry\\Zotero\\storage\\9XBJMPPZ\\Azaad - 2025 - AI-accelerated meta-analysis in psychology Large language models code study properties with high ac.pdf:application/pdf},
}

@article{lewicka_place_2011,
	title = {Place attachment: {How} far have we come in the last 40 years?},
	volume = {31},
	issn = {0272-4944},
