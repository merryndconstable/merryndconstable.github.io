	file = {arXiv Fulltext PDF:C\:\\Users\\merry\\Zotero\\storage\\ZDPSSUWB\\Miraboutalebi et al. - 2022 - Effect of RGUP on the nonlinear Klein-Gordon model.pdf:application/pdf;arXiv.org Snapshot:C\:\\Users\\merry\\Zotero\\storage\\6CU2I7MW\\2205.html:text/html},
}

@misc{park_satisfied_2022,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Satisfied with {People} or {Place}?: {A} {Study} of the {Relationship} between {Social} {Ties}, {Place} {Attachment}, and {Residential} {Satisfaction} {Among} {Relocatees}},
