	number = {12},
	urldate = {2019-03-22},
	journal = {Experimental Brain Research},
	author = {Constable, Merryn D. and Kritikos, Ada and Lipp, Ottmar V. and Bayliss, Andrew P.},
	month = dec,
	year = {2014},
	pages = {3749--3761},
	file = {Constable et al. - 2014 - Object ownership and action the influence of soci.pdf:C\:\\Users\\merry\\Zotero\\storage\\WCK6TZVZ\\Constable et al. - 2014 - Object ownership and action the influence of soci.pdf:application/pdf},
