	abstract = {The endowment effect is the tendency for people who own a good to value it more than people who do not. Its economic impact is consequential. It creates market inefficiencies and irregularities in valuation such as differences between buyers and sellers, reluctance to trade, and mere ownership effects. Traditionally, the endowment effect has been attributed to loss aversion causing sellers of a good to value it more than buyers. New theories and findings – some inconsistent with loss aversion – suggest evolutionary, strategic, and more basic cognitive origins. In an integrative review, we propose that all three major instantiations of the endowment effect are attributable to exogenously and endogenously induced cognitive frames that bias which information is accessible during valuation.},
	language = {en},
	number = {6},
	urldate = {2021-04-29},
	journal = {Trends in Cognitive Sciences},
	author = {Morewedge, Carey K. and Giblin, Colleen E.},
	month = jun,
	year = {2015},
	keywords = {confirmatory hypothesis testing, endowment effect, loss aversion, memory bias, mere ownership effect, willingness to pay–willingness to accept gap},
	pages = {339--348},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\VA84WIFF\\Morewedge and Giblin - 2015 - Explanations of the endowment effect an integrati.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\PSP7H3SW\\S1364661315000789.html:text/html},
}

@article{collard_relationship_2020,
	title = {The relationship between endowment and ownership effects in memory across cultures},
	volume = {78},
	issn = {1053-8100},
	url = {https://www.sciencedirect.com/science/article/pii/S1053810019303101},
	doi = {10.1016/j.concog.2019.102865},
	abstract = {An object one owns is typically more highly valued than an equivalent object owned by another person. This endowment effect has been attributed to the aversion of loss of one’s possessions (through selling), or the added value of an item due to self-association (through owning). To date, investigation of these mechanisms has been hampered by the between-subjects methodology traditionally employed to measure endowment. Over two experiments, we report a novel within-subjects method for measuring an endowment bias. In these studies, Western participants showed enhanced valuation of owned items, whereas East-Asian participants did not. This endowment bias also correlated with the ownership effect in memory (a measure of self-referential processing) in Western, but not East-Asian participants. Our results suggest that the endowment effect is partly predicated on the same factors that influence the ownership effect and that this commonality is likely linked to conceptions of ownership specifically, and self-concept more generally.},
	language = {en},
	urldate = {2021-04-29},
	journal = {Consciousness and Cognition},
	author = {Collard, Philip and Walford, Alexandra and Vernon, Lucy and Itagaki, Fumihiko and Turk, David},
	month = feb,
	year = {2020},
	keywords = {Culture, Endowment effect, Ownership, Self-construal},
	pages = {102865},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\463KMQ7U\\Collard et al. - 2020 - The relationship between endowment and ownership e.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\FIK9BPJN\\S1053810019303101.html:text/html},
}

@article{morewedge_bad_2009,
	title = {Bad riddance or good rubbish? {Ownership} and not loss aversion causes the endowment effect},
	volume = {45},
	issn = {00221031},
	shorttitle = {Bad riddance or good rubbish?},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0022103109001279},
	doi = {10.1016/j.jesp.2009.05.014},
	abstract = {People typically demand more to relinquish the goods they own than they would be willing to pay to acquire those goods if they did not already own them (the endowment effect). The standard economic explanation of this phenomenon is that people expect the pain of relinquishing a good to be greater than the pleasure of acquiring it (the loss aversion account). The standard psychological explanation is that people are reluctant to relinquish the goods they own simply because they associate those goods with themselves and not because they expect relinquishing them to be especially painful (the ownership account). Because sellers are usually owners, loss aversion and ownership have been confounded in previous studies of the endowment effect. In two experiments that deconfounded them, ownership produced an endowment effect but loss aversion did not. In Experiment 1, buyers were willing to pay just as much for a coffee mug as sellers demanded if the buyers already happened to own an identical mug. In Experiment 2, buyers’ brokers and sellers’ brokers agreed on the price of a mug, but both brokers traded at higher prices when they happened to own mugs that were identical to the ones they were trading. In short, the endowment effect disappeared when buyers were owners and when sellers were not, suggesting that ownership and not loss aversion causes the endowment effect in the standard experimental paradigm.},
	language = {en},
	number = {4},
	urldate = {2021-04-28},
	journal = {Journal of Experimental Social Psychology},
	author = {Morewedge, Carey K. and Shu, Lisa L. and Gilbert, Daniel T. and Wilson, Timothy D.},
	month = jul,
	year = {2009},
	pages = {947--951},
	file = {Morewedge et al. - 2009 - Bad riddance or good rubbish Ownership and not lo.pdf:C\:\\Users\\merry\\Zotero\\storage\\THCJYRS7\\Morewedge et al. - 2009 - Bad riddance or good rubbish Ownership and not lo.pdf:application/pdf},
}

