	title = {Facial first impressions are not mandatory: {A} priming investigation},
	volume = {241},
	issn = {0010-0277},
	shorttitle = {Facial first impressions are not mandatory},
	url = {https://www.sciencedirect.com/science/article/pii/S0010027723002548},
	doi = {10.1016/j.cognition.2023.105620},
	abstract = {A common assertion is that, based around prominent character traits, first impressions are spontaneously extracted from faces. Specifically, mere exposure to a person is sufficient to trigger the involuntary extraction of core personality characteristics (e.g., trustworthiness, dominance, competence), an outcome that supports a range of significant judgments (e.g., hiring, investing, electing). But is this in fact the case? Noting ambiguities in the extant literature, here we used a repetition priming procedure to probe the extent to which impressions of dominance are extracted from faces absent the instruction to evaluate the stimuli in this way. Across five experiments in which either the character trait of interest was made increasingly obvious to participants (Expts. 1–3) or attention was explicitly directed toward the faces to generate low-level/high-level judgments (Expts. 4 \& 5), no evidence for the spontaneous extraction of first impressions was observed. Instead, priming only emerged when judgments of dominance were an explicit requirement of the task at hand. Thus, at least using a priming methodology, the current findings contest the notion that first impressions are a mandatory product of person perception.},
	urldate = {2024-09-07},
	journal = {Cognition},
	author = {Sharma, Yadvi and Persson, Linn M. and Golubickis, Marius and Jalalian, Parnian and Falbén, Johanna K. and Macrae, C. Neil},
	month = dec,
	year = {2023},
	keywords = {Dominance, Face processing, Automaticity, First impressions, Person perception, Repetition priming},
	pages = {105620},
	file = {Full Text:C\:\\Users\\merry\\Zotero\\storage\\3PDDVKE7\\Sharma et al. - 2023 - Facial first impressions are not mandatory A prim.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\42CSZTTF\\S0010027723002548.html:text/html},
}

@article{yin_self-bias_2024,
	title = {The self-bias in working memory: the favorability of self-referential stimuli in resource allocation},
	volume = {32},
	issn = {0965-8211},
	shorttitle = {The self-bias in working memory},
	url = {https://doi.org/10.1080/09658211.2024.2341709},
	doi = {10.1080/09658211.2024.2341709},
	abstract = {Self-representations guide and shape our thoughts and behaviour. People usually exhibit inherent biases in perception, attention, and memory to favour the information associated with themselves over that associated with others. The present study explored the phenomenon of self-bias in working memory (WM), specifically how self-referential processing impacts WM precision. Four precision-based experiments were conducted to assess the recall precision of self-referential items and items associated with other social agents. The findings revealed a robust self-prioritisation effect in WM precision, wherein self-referential items were recalled with greater precision than items associated with other social agents. Additionally, increased precision for self-referential items did not decrease the precision for simultaneously remembered items. This effect was limited by the total amount of WM resources and not influenced by a perceptual distractor. The inherent self-bias in WM can serve as a proxy to access the role self-representation in goal-oriented cognitive processing, providing a means of exploring the interaction between self-reference and high-level cognitive function.},
	number = {5},
	urldate = {2024-09-08},
	journal = {Memory},
	publisher = {Routledge},
	author = {Yin, Shouhang and Chen, Antao},
	month = may,
	year = {2024},
	note = {\_eprint: https://doi.org/10.1080/09658211.2024.2341709},
	keywords = {self-reference, Self-bias, working memory, resource allocation, self-prioritisation effect},
	pages = {517--527},
}

