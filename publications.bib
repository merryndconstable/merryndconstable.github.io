	type = {{SSRN} {Scholarly} {Paper}},
	title = {Wave-{Filtering} {Finite}-{Time} {Self}-{Learning} {Extended} {State} {Observers} for {Robotic} {Surface} {Vehicles}},
	url = {https://papers.ssrn.com/abstract=4278487},
	abstract = {This paper presents wave-filtering finite-time self-learning extended state observers for robotic surface vehicles subject to unknown model parameters and ocean disturbances. By incorporating concurrent learning and wave filtering techniques into the design of extended state observer, the low-frequency motion components and wave-frequency motion components of robotic surface vehicles can be estimated, in addition to the unknown model parameters, total disturbance and unmeasured velocity. A salient feature of the proposed approach is that wave-frequency motion components are filtered from the position and yaw angle sensor measurements to avoid mechanical wear and tear of the propulsion system components caused by wave-frequency motion signals. The above result is extended to a wave-filtering finite-time self-learning extended state observer which improves the estimation performance considerably. The efficacy of the proposed two wave-filtering self-learning extend state observers for robotic surface vehicles with unknown model parameters is substantiated via simulations.},
	language = {en},
	urldate = {2024-07-14},
	author = {Yue, Jiawang and Liu, Lu and Peng, Zhouhua and Wang, Dan},
	month = nov,
	year = {2022},
