	month = jul,
	year = {2022},
	keywords = {Surgical education, Assessment, Training, Artificial intelligence},
	pages = {205--216},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\GY6FD2V2\\Bilgic et al. - 2022 - Exploring the roles of artificial intelligence in .pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\merry\\Zotero\\storage\\F6YUTRZW\\S0002961021006826.html:text/html},
