@article{grimmelikhuijsen_validating_2017,
	title = {Validating a scale for citizen trust in government organizations},
	volume = {83},
	issn = {0020-8523},
	url = {https://doi.org/10.1177/0020852315585950},
	doi = {10.1177/0020852315585950},
	abstract = {Citizen trust in government at the macro level has been studied by public administration scholars for many years. To further our understanding, assessing trust at the meso level of government organizations is important to more precisely determine effects and antecedents of trust at the organizational level. The organizational trust literature has shown that organizational trustworthiness is multidimensional, but the extant literature has not validated such measures in a public administration context. The proposed scale builds on and adapts an existing organizational trust scale to a public administration context. The ‘Citizen Trust in Government Organizations’ scale is validated using data from two different samples (total n = 991), resulting in a scale of nine items measuring three dimensions: perceived competence, benevolence, and integrity. This scale can be used by other researchers and is valuable to gain a more specific and multi-dimensional understanding of trust in government organizations.Points for practitionersA major problem for government organizations worldwide is the lack of perceived trustworthiness by the public. To tackle this problem, a way to measure it is needed, but at the moment there are only generic measures to assert perceived trustworthiness in a government organization. This article presents a first validation and incorporates three dimensions: perceived competence, benevolence, and honesty. Practitioners can use this scale and adapt to their relevant local context to identify specific trustworthiness problems.},
	language = {en},
	number = {3},
	urldate = {2025-03-09},
	journal = {International Review of Administrative Sciences},
	publisher = {SAGE Publications Ltd},
	author = {Grimmelikhuijsen, Stephan and Knies, Eva},
	month = sep,
	year = {2017},
	pages = {583--601},
	file = {SAGE PDF Full Text:C\:\\Users\\merry\\Zotero\\storage\\4GM6FHIK\\Grimmelikhuijsen and Knies - 2017 - Validating a scale for citizen trust in government.pdf:application/pdf},
}

