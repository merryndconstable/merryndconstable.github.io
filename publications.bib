@misc{strachan_testing_2023,
	title = {Testing {Theory} of {Mind} in {GPT} {Models} and {Humans}},
	url = {https://www.researchsquare.com/article/rs-3262385/v1},
	doi = {10.21203/rs.3.rs-3262385/v1},
	abstract = {Interacting with other people involves reasoning about and prediction of others\&\#039; mental states, or Theory of Mind. This capacity is a distinguishing feature of human cognition but recent advances in Large Language Models (LLMs) such as ChatGPT suggest that they may possess some emergent capacity for human-like Theory of Mind. Such claims merit a systematic approach to explore the limits of GPT models\&\#039; emergent Theory of Mind capacity and compare it against humans. We show that while GPT models show impressive Theory of Mind-like capacity in controlled tests, there are key deviations from human performance that call into question how human-like this capacity is. Specifically, across a battery of Theory of Mind tests, we found that GPT models performed at human levels when recognising indirect requests, false beliefs, and higher-order mental states like misdirection, but were specifically impaired at recognising faux pas. Follow-up studies revealed that this was due to GPT\&\#039;s conservatism in drawing conclusions that humans took to be self-evident. Our results suggest that while GPT may demonstrate the competence for sophisticated mentalistic inference, its lack of embodiment within an action-oriented environment make this capacity qualitatively different from human cognition.},
	urldate = {2024-04-07},
	author = {Strachan, James and Albergo, Dalila and Borghini, Giulia and Pansardi, Oriana and Scaliti, Eugenio and Rufo, Alessandro and Manzi, Guido and Graziano, Michael and Becchio, Cristina},
	month = aug,
	year = {2023},
	note = {ISSN: 2693-5015},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\MV94RZUE\\Strachan et al. - 2023 - Testing Theory of Mind in GPT Models and Humans.pdf:application/pdf},
}

