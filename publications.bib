	type = {{SSRN} {Scholarly} {Paper}},
	title = {Analyzing the {Preferences} of {Flood} {Victims} on {Post} {Flood} {Public} {Houses} ({Pfph}): {Application} of a {Hybrid} {Choice} {Model} to the {Floodplains} of {Southern} {Pakistan}},
	shorttitle = {Analyzing the {Preferences} of {Flood} {Victims} on {Post} {Flood} {Public} {Houses} ({Pfph})},
	url = {https://papers.ssrn.com/abstract=4353830},
	doi = {10.2139/ssrn.4353830},
	abstract = {Climate change related natural hazards cause significant suffering and economic damage. The aftermath of the loss of one’s home leave people with tough decisions to make. Resettlement of the aggrieved people by flood disaster remains a complex and ambiguous process. This study’s primary motive is to come up with an insight to the determinants influencing the post flood public houses (PFPH) decision in the flood plains. Utilizing a stated preference (SP) survey conducted in the floodplains of Southern Pakistan, this study analyzes the impact of policy variables in conjunction with latent psychometric factors on the choice of people. A hybrid choice model (HCM) is developed to test the influence of two latent variables, risk perception and place attachment. Findings show that people who have a higher risk perception tend to choose PFPH, whereas people who have higher place attachment tend to not choose PFPH, instead, choose rebuilding a house at the same location. Compensation for PFPH was observed to have positive impact on choosing PFPH, meanwhile the distance from village center, i.e., how far they will be relocated from their current village center, had a negative impact on choosing PFPH. The calculation of willingness to accept measures confirmed that for every 1 KM increase in the distance from village center, the respondents would need an additional compensation of PKR 24558.45 ({\textasciitilde} \$109.9). Meanwhile, multiple policy scenario tests were conducted for the economic evaluation of the impact of latent variables and SP attributes on the predicted share of PFPH. The results show substantial contribution of place attachment attitudes and distance to village center attribute on the share of PFPH.},
	language = {en},
	urldate = {2024-07-14},
	author = {Hulio, Abdul Fattah and Varghese, Varun and Chikaraishi, Makoto},
	month = feb,
	year = {2023},
	keywords = {climate change, Place attachment, Flooding, Resettlement, Risk perception},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\UXQVCCYB\\Hulio et al. - 2023 - Analyzing the Preferences of Flood Victims on Post.pdf:application/pdf},
}

@misc{wang_psychological_2023,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Psychological {Ownership} of {Nature}: {Relationships} with {Pro}-{Environmental} {Intentions} in {Less} {Environmentally}-{Oriented} {Individuals}},
	shorttitle = {Psychological {Ownership} of {Nature}},
	url = {https://papers.ssrn.com/abstract=4347556},
	doi = {10.2139/ssrn.4347556},
	abstract = {Broadening community participation in pro-environmental behaviors would benefit from better understanding individuals not yet concerned about nature. In this paper, we examined whether psychological ownership of nature (i.e., the feeling that nature is mine/ours) was positively associated with pro-environmental behavioral intentions and particularly, whether this association was contingent on individual differences in environmental views (i.e., new ecological paradigm, dominionistic beliefs toward nature, environmental self-identity, environmental concern, and value orientations). Based on the jiu-jitsu persuasion model, we hypothesized that psychological ownership of nature would motivate less environmentally-oriented people but might be less effective for those already oriented. Results of a cross-sectional survey distributed to the Australian community (total N = 836) showed that psychological ownership of nature was positively related to the intention to perform civic pro-environmental actions. However, there was limited evidence supporting the proposed moderation, i.e., psychological ownership of nature could be a means to a sustainable end for individuals across the environmental orientation spectrum. This paper contributes to the literature on psychological ownership of nature by examining boundary conditions regarding its usefulness in nature conservation.},
	language = {en},
	urldate = {2024-07-14},
	author = {Wang, Xiongzhi and Fielding, Kelly and Dean, Angela J.},
	month = feb,
