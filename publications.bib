	shorttitle = {Leaving {Means} {Better}?},
	url = {https://papers.ssrn.com/abstract=4583426},
	doi = {10.2139/ssrn.4583426},
	abstract = {In post-disaster reconstruction area, resident’s place attachment needs to be reestablished after facing devasting damage in both physical and psychological environment. Therefore, it’s essential to investigate on residents’ satisfaction with new surroundings. Explorative research in new Beichuan was conducted with 416 questionnaires in 2022, after 14 years of Wenchuan earthquake, which was the only off-site reconstruction county and experienced served devastation. This study aims to investigate residential satisfaction in new Beichuan, and explore the pathway of external perception, disaster perception and place attachment. Structural equation model was applied to analyze the relationship among the residential satisfaction, social ties, perceived risk and place attachment. Results revealed that residents in new Beichuan are generally satisfied with residential environment, which positively affect place attachment. Social ties have positive impact on place attachment. Interestingly, social ties have negative impact on perceived risk. And perceived risk was found to mediate the relationship between residential satisfaction and place attachment, and the relationship between social ties and place attachment. Policymakers should carefully consider residents’ requirements and lifestyle in the reconstruction period of geology disaster, and create livable environment and social space to help post-disaster migrants rebuild residents’ place attachments.},
	language = {en},
	urldate = {2024-07-14},
	author = {Xiang, Xin and Xiao, Yi and Wang, Ruonan and Huang, Huan},
	month = sep,
