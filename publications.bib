@article{hoyt_political_2016,
	title = {Political ideology and {American} intergroup discrimination: {A} patriotism perspective},
	volume = {156},
	issn = {1940-1183},
	shorttitle = {Political ideology and {American} intergroup discrimination},
	doi = {10.1080/00224545.2015.1106434},
	abstract = {In this research we demonstrate the powerful role of ingroup favoritism, rather than hostility, in American intergroup biases. Specifically, we take a novel perspective to understanding the relationship between political ideology and discrimination against ethnic-minority Americans by focusing on the role of patriotism. Across three studies, we show that political ideology is a strong predictor of resource allocation biases, and this effect is mediated by American patriotism and not by prejudice or nationalism. Conservatives report greater levels of patriotism than liberals, and patriotism is associated with donating more to American, as opposed to ethnic-minority American, organizations. We further show that the link between patriotism and partiality to the national group is mediated by stronger "American = White" associations. These findings have important implications for intergroup relations and diversity-related policy issues in the United States.},
	language = {eng},
	number = {4},
	journal = {The Journal of Social Psychology},
	author = {Hoyt, C.L. and Goldin, Aleah},
	month = aug,
	year = {2016},
	keywords = {Humans, Female, Male, Adult, Young Adult, Group Processes, Social Identification, United States, Discrimination, favoritism, intergroup biases, patriotism, political ideology, Politics, Racism, Social Discrimination},
	pages = {369--381},
}

