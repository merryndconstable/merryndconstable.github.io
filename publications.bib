	keywords = {Physics - Fluid Dynamics, Nonlinear Sciences - Adaptation and Self-Organizing Systems, Condensed Matter - Statistical Mechanics, Quantum Physics, Physics - Data Analysis, Statistics and Probability},
	pages = {024802},
	file = {arXiv Fulltext PDF:C\:\\Users\\merry\\Zotero\\storage\\WS5G96CA\\Rodriguez-Fernandez et al. - 2022 - Anomalous ballistic scaling in the tensionless or .pdf:application/pdf;arXiv.org Snapshot:C\:\\Users\\merry\\Zotero\\storage\\GZVAM4XG\\2205.html:text/html},
}

