	journal = {International Journal of Methods in Psychiatric Research},
	author = {Kessler, Ronald C. and Adler, Lenard A. and Gruber, Michael J. and Sarawate, Chaitanya A. and Spencer, Thomas and Van Brunt, David L.},
	year = {2007},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/mpr.208},
	keywords = {adult ADHD, ASRS screener, attention-deficit/hyperactivity disorder (ADHD)},
