@article{azari_can_2018-1,
	title = {Can {Surgical} {Performance} for {Varying} {Experience} be {Measured} from {Hand} {Motions}?},
	volume = {62},
	issn = {2169-5067},
	url = {https://doi.org/10.1177/1541931218621133},
	doi = {10.1177/1541931218621133},
	abstract = {This study evaluates if hand movements, tracked using digital video, can quantify in-context surgical performance. Participants of varied experience completed simple interrupted suturing and running subcuticular suturing tasks. Marker-less motion tracking software traced the two-dimensional position of a region of the hand for every video frame. Four expert observers rated 219 short video clips of participants performing the task from 0 to 10 along the following visual analog scales: fluidity of motion, motion economy, tissue handling, and coordination. Expert ratings of attending surgeon hand motions (mean=7.5, sd=1.3) were significantly greater (p{\textless}0.05) than medical students (mean=5.0, sd=1.9) and junior residents (mean=6.4, sd=1.5) for all rating scales. Significant differences (p{\textless}0.02) in mean path length per cycle were also observed both between medical students (803 mm, sd=374) and senior residents (491 mm, sd=216), and attendings (424 mm, sd=250) and junior residents (609 mm, sd=187). These results suggest that substantial gains in performance are attained after the second year of residency and that hand kinematics can predict differences in expert ratings for simulated suturing tasks commensurate with experience – a necessary step to develop valid and automatic on-demand feedback tools.},
	language = {en},
	number = {1},
	urldate = {2021-01-05},
	journal = {Proceedings of the Human Factors and Ergonomics Society Annual Meeting},
	publisher = {SAGE Publications Inc},
	author = {Azari, David P. and Miller, Brady L. and Le, Brian V. and Greenberg, Jacob A. and Greenberg, Caprice C. and Pugh, Carla M. and Hu, Yu Hen and Radwin, Robert G.},
	month = sep,
	year = {2018},
	pages = {583--587},
	file = {SAGE PDF Full Text:C\:\\Users\\merry\\Zotero\\storage\\CHQIAXPD\\Azari et al. - 2018 - Can Surgical Performance for Varying Experience be.pdf:application/pdf},
}

