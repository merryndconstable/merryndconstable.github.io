	month = nov,
	year = {2017},
	keywords = {ergonomic control, ergonomics, Force, human arm manipulability properties, human body joints, human co-worker, human-robot co-manipulation, human-robot interaction, human-robot object handover, manipulation ccapacity, online estimation, optimisation process, Optimization, overloading joint torques, Robot kinematics, Robot sensing systems, Torque, whole-body dynamic model, work-related strain reduction},
	pages = {55--60},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\merry\\Zotero\\storage\\QFVVJANN\\8239537.html:text/html},
