@article{noauthor_artificial_2020,
	title = {Artificial {Intelligent} {Model} {With} {Neural} {Network} {Machine} {Learning} for the {Diagnosis} of {Orthognathic} {Surgery}: {Erratum}},
	volume = {31},
	issn = {1536-3732 (Electronic) 1049-2275 (Linking)},
	url = {https://www.ncbi.nlm.nih.gov/pubmed/32503100},
