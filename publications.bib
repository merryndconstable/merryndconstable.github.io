	pages = {183--214},
	file = {Full Text:C\:\\Users\\merry\\Zotero\\storage\\UT3NGXJM\\Cowan et al. - 2024 - The Relation Between Attention and Memory.pdf:application/pdf;Snapshot:C\:\\Users\\merry\\Zotero\\storage\\F4K33K7G\\annurev-psych-040723-012736.html:text/html},
