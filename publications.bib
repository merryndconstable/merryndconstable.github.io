@misc{chaudhary_littering_2023,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Littering as a ‘{Tragedy} of the {Commons}’ {Problem} – the {Role} of {Personal} {Responsibility} and {Place} {Attachment}},
	url = {https://papers.ssrn.com/abstract=4354914},
	doi = {10.2139/ssrn.4354914},
	abstract = {This research has applied an integrated norms model using place attachment, anti-littering descriptive and injunctive norms, and anti-littering personal norms to assess anti-littering behavioral intentions in a developing country. Further, the application of the ‘tragedy of the commons’ phenomenon to examine littering in a developing country has not previously been explored. After a pre-test to validate scales, a survey was conducted among visitors at a beach in Pakistan. This main survey was performed among a sample of 634 respondents to assess direct, mediated, and conditional indirect effect relationships using structural equation modelling and PROCESS model 7. Place attachment was found to strengthen the effect of descriptive norms. The influence of both social norms (i.e., descriptive and injunctive) on anti-littering behavior was only consistent when mediated by personal norms, suggesting the importance of individuals’ own responsibility. Thus, it appears that littering is a ‘tragedy of the commons’ phenomenon, based on the roles of personal norms and place attachment in discouraging littering. This perspective has important implications because littering in public places such as beaches has been determined as a substantial environmental problem requiring solutions focussed on individuals.},
	language = {en},
	urldate = {2024-07-14},
	author = {Chaudhary, Abdul Haseeb and Polonsky, Michael and McClaren, Nicholas},
	month = feb,
	year = {2023},
	keywords = {place attachment, anti-littering behavioral intentions, descriptive norms, environmental pollution, injunctive norms, personal norms},
	file = {Full Text PDF:C\:\\Users\\merry\\Zotero\\storage\\N79BD7J3\\Chaudhary et al. - 2023 - Littering as a ‘Tragedy of the Commons’ Problem – .pdf:application/pdf},
}

@misc{hulio_analyzing_2023,
