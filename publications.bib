@article{hartley_does_2021,
	title = {Does {Autism} {Affect} {Children}’s {Identification} of {Ownership} and {Defence} of {Ownership} {Rights}?},
	volume = {51},
	issn = {1573-3432},
	url = {https://doi.org/10.1007/s10803-021-04872-6},
	doi = {10.1007/s10803-021-04872-6},
	abstract = {This study investigated how autism spectrum disorder (ASD) impacts children’s ability to identify ownership from linguistic cues (proper nouns vs. possessive pronouns) and their awareness of ownership rights. In comparison to typically developing (TD) children matched on receptive language (M age equivalents: 53–56 months), children with ASD were less accurate at tracking owner-object relationships based on possessive pronouns and were less accurate at identifying the property of third parties. We also found that children with ASD were less likely to defend their own and others’ ownership rights. We hypothesise that these results may be attributed to differences in representing the self and propose that ASD may be characterised by reduced concern for ownership and associated concepts.},
	language = {en},
	number = {11},
	urldate = {2024-12-15},
